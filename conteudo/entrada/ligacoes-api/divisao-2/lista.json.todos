[{"disciplina":"Atividade de Inteligência e Legislação Correlata","texto":"Plano de Carreiras e Cargos da Agência Brasileira de Inteligência e carreiras de Oficial de Inteligência, Oficial Técnico de Inteligência, Agente de Inteligência e Agente Técnico de Inteligência."},{"disciplina":"Direito Administrativo","texto":"Entidades paraestatais."},{"disciplina":"Raciocínio Lógico","texto":"Estruturas lógicas."},{"disciplina":"Raciocínio Lógico","texto":"Diagramas lógicos."},{"disciplina":"Ciências Humanas","texto":"Integração entre indústria, estrutura urbana, rede de transportes e setor agrícola no Brasil."},{"disciplina":"Ciências Humanas","texto":"Integração do Brasil ao processo de internacionalização da economia."},{"disciplina":"Atividade de Inteligência e Legislação Correlata","texto":"Lei nº 11.776/2008 (estruturação do Plano de Carreiras e Cargos da ABIN e criação das carreiras de Oficial de Inteligência, Oficial Técnico de Inteligência, Agente de Inteligência e Agente Técnico de Inteligência)."},{"disciplina":"Direito Administrativo","texto":"Controle parlamentar."},{"disciplina":"Direito Administrativo","texto":"Controle da atividade financeira do Estado: espécies e sistemas."},{"disciplina":"Geografia do Brasil","texto":"Integração entre indústria, estrutura urbana, rede de transportes e setor agrícola no Brasil."},{"disciplina":"Geografia Mundial","texto":"Caracterização geral dos sistemas político-econômicos contemporâneos e suas áreas de influência e disputa."},{"disciplina":"Direito Internacional Público","texto":"Convenções internacionais sobre terrorismo: Convenção Internacional sobre a Supressão de Atentados Terroristas com Bombas; Convenção Internacional para a Supressão do Financiamento do Terrorismo; Convenção Interamericana Contra o Terrorismo."},{"disciplina":"Direito Penal","texto":"Princípios básicos do direito penal."},{"disciplina":"Macroeconomia","texto":"Balanço de pagamentos."},{"disciplina":"Microeconomia","texto":"Seguro."},{"disciplina":"Estatística e Econometria","texto":"Principais distribuições: Bernoulli, Binomial, Poisson, Geométrica, Hipergeométrica, Uniforme, Normal, Lognormal, Qui-quadrado, t e F."},{"disciplina":"Ciência Política","texto":"Sistemas eleitorais e partidos políticos."},{"disciplina":"Ciência Política","texto":"Representação política."},{"disciplina":"Ciências Sociais","texto":"Sociologia política."},{"disciplina":"Administração Pública","texto":"Características básicas das organizações formais modernas: tipos de estrutura organizacional, natureza, finalidades e critérios de departamentalização."},{"disciplina":"Administração Pública","texto":"Lei Complementar nº 131/2009 (Lei da Transparência)."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Orçamento na Constituição de 1988: Plano Plurianual (PPA), Lei de Diretrizes Orçamentárias (LDO), Lei Orçamentária Anual (LOA)."},{"disciplina":"Contabilidade Aplicada ao Setor Público","texto":"Conceituação, objeto e campo de aplicação."},{"disciplina":"Noções de Economia","texto":"Os planos de desenvolvimento mais importantes desde a segunda metade do século XX."},{"disciplina":"Direito Administrativo","texto":"Regime jurídico-administrativo e princípios expressos e implícitos."},{"disciplina":"Direito Constitucional","texto":"Organização político-administrativa do Estado, União, estados, municípios, Distrito Federal e territórios."},{"disciplina":"Raciocínio Lógico-Matemático","texto":"Funções e gráficos."},{"disciplina":"Raciocínio Lógico-Matemático","texto":"Diagramas lógicos."},{"disciplina":"Conhecimentos Específicos – Medicina Veterinária","texto":"RIISPOA (Decreto n. 9.013/2017), SUASA e legislação estadual de inspeção."},{"disciplina":"Noções de Administração Pública","texto":"Planejamento estratégico e orçamento público: PPA, LDO e LOA."},{"disciplina":"Noções de Administração Pública","texto":"Regime jurídico dos servidores, processo administrativo e parcerias público-privadas."},{"disciplina":"Noções de Administração Pública","texto":"Licitações e contratos administrativos."},{"disciplina":"Língua Portuguesa","texto":"Ortografia oficial e mecanismos de coesão textual."},{"disciplina":"Direito Constitucional","texto":"Classificação."},{"disciplina":"Direito Constitucional","texto":"Direitos Humanos."},{"disciplina":"Direito Constitucional","texto":"Processo Legislativo Estadual."},{"disciplina":"Direito Constitucional","texto":"Funções."},{"disciplina":"Direito Constitucional","texto":"Organização."},{"disciplina":"Direito Constitucional","texto":"Sistema tributário nacional."},{"disciplina":"Direito Constitucional","texto":"Direito de propriedade."},{"disciplina":"Direito Constitucional","texto":"Constituição da República Federativa do Brasil de 1988."},{"disciplina":"Direito Constitucional","texto":"Constituição do Estado de Minas Gerais."},{"disciplina":"Direito Administrativo","texto":"Vinculação e discricionariedade."},{"disciplina":"Direito Administrativo","texto":"Recursos administrativos."},{"disciplina":"Direito Administrativo","texto":"Contrato de gestão."},{"disciplina":"Direito Administrativo","texto":"Tombamento."},{"disciplina":"Direito Administrativo","texto":"Regimes previdenciários."},{"disciplina":"Direito Administrativo","texto":"Ação regressiva."},{"disciplina":"Direito Civil","texto":"Das pessoas."},{"disciplina":"Direito Civil","texto":"Do registro civil das pessoas jurídicas."},{"disciplina":"Direito Civil","texto":"A prescrição e a Fazenda Pública."},{"disciplina":"Direito Civil","texto":"Preferências e privilégios creditórios."},{"disciplina":"Direito Civil","texto":"Direito do promitente comprador."},{"disciplina":"Direito Civil","texto":"Registro de imóveis."},{"disciplina":"Direito Civil","texto":"Lei nº 8.069/90 (Estatuto da Criança e do Adolescente)."},{"disciplina":"Direito Processual Civil","texto":"Processo."},{"disciplina":"Direito Processual Civil","texto":"Pressupostos processuais."},{"disciplina":"Direito Processual Civil","texto":"Incidente de arguição de inconstitucionalidade."},{"disciplina":"Direito Empresarial","texto":"Direito de Empresa."},{"disciplina":"Direito Empresarial","texto":"Classificação."},{"disciplina":"Direito Empresarial","texto":"Teoria ultra vires."},{"disciplina":"Direito Empresarial","texto":"Reorganização societária."},{"disciplina":"Direito Empresarial","texto":"Grupo econômico."},{"disciplina":"Direito Empresarial","texto":"Contratos típicos e atípicos ou inominados."},{"disciplina":"Direito Empresarial","texto":"Contratos Bancários."},{"disciplina":"Direito Empresarial","texto":"Seguro."},{"disciplina":"Direito Empresarial","texto":"Protesto cambiário."},{"disciplina":"Direito do Trabalho e Processual do Trabalho","texto":"Organização."},{"disciplina":"Direito Previdenciário Federal e Estadual","texto":"Principais normas aplicáveis: Lei 8.212/91, Lei 8.213/91, Decreto 3.048/1999."},{"disciplina":"Direito Tributário, Financeiro e Legislação Tributária","texto":"Impostos da União, dos Estados, do Distrito Federal e dos Municípios."},{"disciplina":"Direito Tributário, Financeiro e Legislação Tributária","texto":"Capacidade tributária."},{"disciplina":"Direito Tributário, Financeiro e Legislação Tributária","texto":"Normas gerais."},{"disciplina":"Direito Tributário, Financeiro e Legislação Tributária","texto":"Classificação."},{"disciplina":"Direito Tributário, Financeiro e Legislação Tributária","texto":"Tribunais de Contas."},{"disciplina":"Direito Tributário, Financeiro e Legislação Tributária","texto":"Prestação de contas."},{"disciplina":"Direito Tributário, Financeiro e Legislação Tributária","texto":"Sistema Tributário Estadual."},{"disciplina":"Direito Tributário, Financeiro e Legislação Tributária","texto":"Contencioso Administrativo Fiscal: Instauração, Impugnação e Reclamação, Instrução Processual."},{"disciplina":"Direito Tributário, Financeiro e Legislação Tributária","texto":"Constituição do Estado de Minas Gerais."},{"disciplina":"Direito Ambiental","texto":"Sistema Nacional do Meio Ambiente (SISNAMA) e Sistema Estadual de Meio Ambiente (SISEMA) de Minas Gerais: órgãos e competência."},{"disciplina":"Direito Penal","texto":"Concurso aparente de normas."},{"disciplina":"Direito Penal","texto":"Sujeitos."},{"disciplina":"Direito Penal","texto":"Bem jurídico."},{"disciplina":"Direito Penal","texto":"Culpabilidade e pena."},{"disciplina":"Direito Processual Penal","texto":"Procedimento."},{"disciplina":"Direito Processual Penal","texto":"Decisões interlocutórias."},{"disciplina":"Direito Processual Penal","texto":"Habeas Corpus."},{"disciplina":"Língua Portuguesa","texto":"Domínio da ortografia oficial. Emprego das letras. Emprego da acentuação gráfica."},{"disciplina":"Língua Portuguesa","texto":"Domínio dos mecanismos de coesão textual. Emprego de elementos de referenciação, substituição e repetição, de conectores e outros elementos de sequenciação textual. Emprego/correlação de tempos e modos verbais."},{"disciplina":"Língua Portuguesa","texto":"Domínio da estrutura morfossintática do período. Relações de coordenação entre orações e entre termos da oração. Relações de subordinação entre orações e entre termos da oração. Emprego dos sinais de pontuação. Concordância verbal e nominal. Emprego do sinal indicativo de crase. Colocação dos pronomes átonos."},{"disciplina":"Língua Portuguesa","texto":"Reescritura de frases e parágrafos do texto. Substituição de palavras ou de trechos de texto. Retextualização de diferentes gêneros e níveis de formalidade."},{"disciplina":"Noções de Informática","texto":"MSOffice M365 (Word, Excel, Power Point)."},{"disciplina":"Conhecimentos Básicos","texto":"Lei nº 14.133/2021."},{"disciplina":"Conhecimentos Básicos","texto":"Lei nº 13.848/2019 (Lei Geral das Agências Reguladoras)."},{"disciplina":"Conhecimentos Básicos","texto":"Teoria da agência."},{"disciplina":"Conhecimentos Básicos","texto":"Serviços públicos. Conceito, classificação, regulamentação e controle, forma, meios e requisitos. Delegação. Concessão, permissão e autorização."},{"disciplina":"Conhecimentos Básicos","texto":"Formas de Estado e formas e sistemas de governo."},{"disciplina":"Conhecimentos Básicos","texto":"Regulação. Agências reguladoras. Papel regulador do Estado. Pressupostos, objetivos e instrumentos. Agências reguladoras e princípio da legalidade. Órgãos reguladores no Brasil. Histórico, conceito, estrutura jurídica, funções, controle e características das autarquias. Autonomia administrativa e poder normativo. Reforma do Estado e o papel das agências reguladoras. Abordagens."},{"disciplina":"Conhecimentos Básicos","texto":"Teoria econômica da regulação, teoria da captura, teoria do agente principal. Formas de regulação. Regulação de preço, regulação de entrada, regulação de qualidade. Boas práticas regulatórias. Análise de impacto regulatório (AIR), avaliação de resultado regulatório (ARR), agenda regulatória e o processo de participação e controle social. Regulação contratual e regulação discricionária."},{"disciplina":"Conhecimentos Básicos","texto":"Mutabilidade dos contratos de concessão e PPPs."},{"disciplina":"Conhecimentos Básicos","texto":"Reequilíbrio econômicofinanceiro."},{"disciplina":"Conhecimentos Básicos","texto":"Diferenças entre taxa, tarifa e contraprestação pública."},{"disciplina":"Conhecimentos Específicos","texto":"Evolução da administração. principais abordagens da administração (clássica até contingencial). Evolução da administração pública no Brasil (após 1930); reformas administrativas; a nova gestão pública. Governança, governabilidade e accountability na administração pública. Transparência na administração pública. Processos participativos de gestão pública. Qualidade na administração pública."},{"disciplina":"Conhecimentos Específicos","texto":"Gestão por resultado na produção de serviços públicos. Plano de Reforma do Aparelho do Estado."},{"disciplina":"Conhecimentos Específicos","texto":"Processo administrativo. Funções de administração: planejamento, organização, direção e controle. Processo de planejamento. Planejamento estratégico: visão, missão e análise SWOT, matriz GUT e ferramenta 5W2H. Análise competitiva e estratégias genéricas. Redes e alianças. Planejamento tático. Planejamento operacional. Administração por objetivos. Balanced scorecard. Processo decisório."},{"disciplina":"Conhecimentos Específicos","texto":"Organização. Estrutura organizacional. Tipos de departamentalização: características, vantagens e desvantagens de cada tipo. Organização informal. Cultura organizacional. Direção. Motivação e liderança. Comunicação. Descentralização e delegação. Controle. Características. Tipos, vantagens e desvantagens. Sistema de medição de desempenho organizacional."},{"disciplina":"Conhecimentos Específicos","texto":"Gestão de pessoas. Equilíbrio organizacional. Objetivos, desafios e características da gestão de pessoas. Análise e descrição de cargos. Capacitação de pessoas. Gestão de desempenho. Gestão por competências. Carreira."},{"disciplina":"Conhecimentos Específicos","texto":"Gestão da qualidade e modelo de excelência gerencial. Principais teóricos e suas contribuições para a gestão da qualidade. Ferramentas de gestão da qualidade."},{"disciplina":"Conhecimentos Específicos","texto":"Gestão de projetos. Elaboração, análise e avaliação de projetos. Principais características dos modelos de gestão de projetos. Projetos e suas etapas."},{"disciplina":"Conhecimentos Específicos","texto":"Gestão de processos. Conceitos da abordagem por processos. Técnicas de mapeamento, análise e melhoria de processos. Noções de estatística aplicada ao controle e à melhoria de processos. BPM."},{"disciplina":"Conhecimentos Específicos","texto":"Administração financeira. Indicadores de desempenho: tipos, variáveis. Planejamento financeiro de curto e longo prazo. Noções de análise de balanços e demonstrações financeiras."},{"disciplina":"Conhecimentos Específicos","texto":"Legislação administrativa. Administração direta, indireta e fundacional. Atos administrativos. Requisição. Lei estadual nº 20.656/2021."},{"disciplina":"Conhecimentos Específicos","texto":"Orçamento público. Princípios orçamentários. Diretrizes orçamentárias. Processo orçamentário. Métodos, técnicas e instrumentos do orçamento público; normas legais aplicáveis. Receita pública: categorias, fontes, estágios, dívida ativa. Despesa pública: categorias, estágios. Suprimento de fundos. Restos a pagar. Despesas de exercícios anteriores. Conta Única do Tesouro."},{"disciplina":"Conhecimentos Específicos","texto":"Licitação pública. Modalidades, dispensa e inexigibilidade. Pregão. Contratos e compras. Convênios e termos similares."},{"disciplina":"Conhecimentos Específicos","texto":"Monitoramento e controle financeiro. Métodos de controle financeiro. Ajustes e correções."},{"disciplina":"Conhecimentos Específicos","texto":"Gestão de risco financeiro. Identificação de riscos financeiros. Estratégias de mitigação. Monitoramento contínuo de riscos."},{"disciplina":"Conhecimentos Específicos","texto":"Lei nº 14.133/2021 (Nova Lei de Licitações)."},{"disciplina":"Conhecimentos Específicos","texto":"Decreto-Lei nº 4.657/1942 (Lei de Introdução às Normas do Direito Brasileiro)."},{"disciplina":"Conhecimentos Específicos","texto":"Lei Complementar nº 214/2025 (institui o imposto sobre bens e serviços – IBS, a contribuição social sobre bens e serviços – CBS, e o imposto seletivo – IS)."},{"disciplina":"Conhecimentos Específicos","texto":"Lei nº 9.984/2000 (cria a Agência Nacional de Águas – ANA)."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Orçamento segundo a Constituição da República de 1988 e na Lei de Responsabilidade Fiscal (LRF)."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Mecanismos retificadores do orçamento, créditos ordinários e adicionais."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Receita pública. Conceitos, classificações e estágios. Despesa pública. Conceitos, classificações e estágios. Dívida ativa. Restos a pagar. Despesas de exercícios anteriores."},{"disciplina":"Finanças","texto":"Análise de balanços e demonstrações financeiras."},{"disciplina":"Finanças","texto":"Estrutura de capital."},{"disciplina":"Finanças","texto":"Relação entre estrutura de capital, problemas de governança corporativa e custos de agência."},{"disciplina":"Finanças","texto":"Captação de recursos próprios e de terceiros de longo prazo."},{"disciplina":"Finanças","texto":"Equivalência financeira. Valor do dinheiro no tempo, taxa de desconto, custo de oportunidade do capital."},{"disciplina":"Finanças","texto":"Métodos de avaliação de fluxos de caixa. Valor presente líquido, taxa interna de retorno, ponto de Fisher, TIR modificada."},{"disciplina":"Administração Pública e Regulação","texto":"Formas de Estado e formas e sistemas de governo."},{"disciplina":"Administração Pública e Regulação","texto":"Regulação e agências reguladoras. Papel regulador do Estado. Pressupostos, objetivos e instrumentos."},{"disciplina":"Administração Pública e Regulação","texto":"Reforma do Estado e papel das agências reguladoras."},{"disciplina":"Administração Pública e Regulação","texto":"Mutabilidade dos contratos de concessão e PPPs."},{"disciplina":"Administração Pública e Regulação","texto":"Reequilíbrio econômico-financeiro."},{"disciplina":"Administração Pública e Regulação","texto":"Diferenças entre taxa, tarifa e contraprestação pública."},{"disciplina":"Gestão de Custos","texto":"Classificação e nomenclatura dos custos. Custos diretos e indiretos. Custos fixos, variáveis, semifixos e semivariáveis. Custos controláveis e não controláveis. Custos históricos, estimados e projetados. Custos relevantes, irrelevantes, evitáveis, inevitáveis, incrementais, diferenciais e afundados."},{"disciplina":"Gestão de Custos","texto":"Métodos de custeio. Custeio por absorção. Custeio variável ou direto. Custeio baseado em atividades (ABC). Impactos dos métodos de custeio sobre estoques, resultado e decisão."},{"disciplina":"Gestão de Custos","texto":"Custos para controle. Custos reais. Custos estimados. Custos projetados. Finalidades gerenciais e limitações."},{"disciplina":"Gestão de Custos","texto":"Ponto de equilíbrio. Conceito. Ponto de equilíbrio contábil. Ponto de equilíbrio econômico. Ponto de equilíbrio financeiro. Variações do ponto de equilíbrio. Margem de segurança. Grau de alavancagem operacional."},{"disciplina":"Gestão de Custos","texto":"Análise de custos para tomada de decisão. Formação de preços com base em custos. Aceitação ou rejeição de pedidos especiais. Decisão de fabricar ou comprar. Decisão de continuar, ampliar, reduzir ou descontinuar produtos, serviços, departamentos ou segmentos."},{"disciplina":"Contabilidade","texto":"Conceituação, objeto e campo de aplicação."},{"disciplina":"Contabilidade","texto":"Composição do patrimônio público. Patrimônio público. Ativo. Passivo. Saldo patrimonial."},{"disciplina":"Contabilidade","texto":"Variações patrimoniais. Qualitativas. Quantitativas: receita e despesa sob o enfoque patrimonial. Realização da variação patrimonial. Resultado patrimonial."},{"disciplina":"Contabilidade","texto":"Regime orçamentário e regime contábil."},{"disciplina":"Contabilidade","texto":"Mensuração de ativos. Ativo imobilizado. Ativo intangível. Reavaliação e redução ao valor recuperável. Depreciação, amortização e exaustão."},{"disciplina":"Contabilidade","texto":"Mensuração de passivos. Provisões. Passivos contingentes."},{"disciplina":"Contabilidade","texto":"Tratamento contábil aplicável aos impostos e contribuições."},{"disciplina":"Contabilidade","texto":"Sistema de custos. Aspectos legais do sistema de custos. Ambiente da informação de custos. Características da informação de custos. Terminologia de custos."},{"disciplina":"Contabilidade","texto":"Estrutura do plano de contas aplicado ao setor público (PCASP). Naturezas da informação contábil. Código da conta contábil. Atributos da informação contábil. Regras de integridade do PCASP."},{"disciplina":"Contabilidade","texto":"Demonstrações contábeis aplicadas ao setor público. Balanço orçamentário. Balanço financeiro. Demonstração das variações patrimoniais. Balanço patrimonial. Demonstração de fluxos de caixa. Demonstração das mutações do patrimônio líquido. Notas explicativas às demonstrações contábeis. Consolidação das demonstrações contábeis."},{"disciplina":"Contabilidade","texto":"Transações no setor público."},{"disciplina":"Contabilidade","texto":"Créditos adicionais."},{"disciplina":"Contabilidade","texto":"Despesas com pessoal. Definições e limites. Controle da despesa total com pessoal."},{"disciplina":"Contabilidade","texto":"Normas Brasileiras de Contabilidade. NBC TSP Estrutura Conceitual (R1). Objetivos e usuários da informação contábil de propósito geral das entidades do setor público. Características qualitativas. Entidade que reporta a informação contábil. Elementos das demonstrações contábeis. Reconhecimento nas demonstrações contábeis. Mensuração de ativos e passivos nas demonstrações contábeis. NBC TSP."},{"disciplina":"Contabilidade","texto":"(R1) – políticas contábeis, mudança de estimativa e retificação de erro. NBC TSP 34 – custos no setor público."},{"disciplina":"Contabilidade","texto":"Análise das demonstrações contábeis. Análise horizontal e vertical. Indicadores de estrutura de capital. Indicadores de liquidez. Indicadores de endividamento. Análise de informações extraídas das notas explicativas."},{"disciplina":"Contabilidade","texto":"Relatório resumido da execução orçamentária (RREO)."},{"disciplina":"Contabilidade","texto":"NBCASP (Normas Brasileiras de Contabilidade Aplicada ao Setor Público): NBC T a do Conselho Federal de Contabilidade."},{"disciplina":"Contabilidade","texto":"Contabilidade regulatória. Plano de contas regulatório. Contabilização dos bens da concessão. Contabilização de ativos e passivos regulatórios. Custos e despesas do setor de saneamento básico."},{"disciplina":"Contabilidade","texto":"Auditoria. Conceitos, objetivos e exercícios práticos. Normas gerais de auditoria. Distinção entre auditoria interna, auditoria independente e perícia contábil. Procedimentos de auditoria. Testes de observância. Testes substantivos. Papéis de trabalho e documentação de auditoria. Normas de execução dos trabalhos de auditoria. Planejamento da auditoria. Relevância na auditoria. Riscos da auditoria."},{"disciplina":"Legislação","texto":"Lei nº 14.133/2021 (nova lei de licitações)."},{"disciplina":"Legislação","texto":"Decreto-Lei nº 4.657/1942 (Lei de Introdução às Normas do Direito Brasileiro)."},{"disciplina":"Legislação","texto":"Lei Complementar nº 214/ 2025 (institui o imposto sobre bens e serviços – IBS, a contribuição social sobre bens e serviços – CBS, e o imposto seletivo – IS; cria o Comitê Gestor do IBS e altera a legislação tributária)."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Orçamento segundo a Constituição da República de 1988 e na Lei de Responsabilidade Fiscal (LRF). Plano plurianual – PPA, lei de diretrizes orçamentárias e financeiras – LDO, lei orçamentária anual – LOA. Ciclo orçamentário."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Dívida flutuante e fundada."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Acompanhamento e controle da execução orçamentária."},{"disciplina":"Administração Pública e Regulação","texto":"Reforma do Estado e papel das agências reguladoras. Abordagens. Teoria econômica da regulação, teoria da captura, teoria do agente principal. Formas de regulação. Regulação de preço, regulação de entrada, regulação de qualidade. Regulação contratual e regulação discricionária."},{"disciplina":"Administração Pública e Regulação","texto":"Seleção adversa e risco moral."},{"disciplina":"Administração Pública e Regulação","texto":"Modelos de regulação. Custo do serviço, price cap, revenue cap. Regulação por incentivos."},{"disciplina":"Administração Pública e Regulação","texto":"Diferença entre revisão e reajuste."},{"disciplina":"Administração Pública e Regulação","texto":"Classificação e nomenclatura dos custos. Custos diretos e indiretos. Custos fixos, variáveis, semifixos e semivariáveis. Custos controláveis e não controláveis. Custos históricos, estimados e projetados. Custos relevantes, irrelevantes, evitáveis, inevitáveis, incrementais, diferenciais e afundados."},{"disciplina":"Administração Pública e Regulação","texto":"Métodos de custeio. Custeio por absorção. Custeio variável ou direto. Custeio baseado em atividades (ABC). Impactos dos métodos de custeio sobre estoques, resultado e decisão."},{"disciplina":"Administração Pública e Regulação","texto":"Custos para controle. Custos reais. Custos estimados. Custos projetados. Finalidades gerenciais e limitações."},{"disciplina":"Administração Pública e Regulação","texto":"Ponto de equilíbrio. Conceito. Ponto de equilíbrio contábil. Ponto de equilíbrio econômico. Ponto de equilíbrio financeiro. Variações do ponto de equilíbrio. Margem de segurança. Grau de alavancagem operacional."},{"disciplina":"Administração Pública e Regulação","texto":"Análise de custos para tomada de decisão. Formação de preços com base em custos. Aceitação ou rejeição de pedidos especiais. Decisão de fabricar ou comprar. Decisão de continuar, ampliar, reduzir ou descontinuar produtos, serviços, departamentos ou segmentos."},{"disciplina":"Legislação Específica","texto":"Lei nº 14.133/2021 (licitações e contratos)."},{"disciplina":"Legislação Específica","texto":"Lei nº 9.984/2000 (cria a Agência Nacional de Águas – ANA)."},{"disciplina":"Legislação Específica","texto":"Lei nº 13.448/2017 (estabelece diretrizes gerais para prorrogação e relicitação dos contratos de parceria definidos nos termos da Lei nº 13.334/2016, nos setores rodoviário, ferroviário e aeroportuário da administração pública federal, e altera a Lei nº 10.233/2001 e a Lei nº 8.987/1995)."},{"disciplina":"Legislação Específica","texto":"Lei nº 13.848/2019 (Lei Geral das Agências Reguladoras)."},{"disciplina":"Direito Constitucional","texto":"Constituição. Conceito, objeto, elementos e classificações. Supremacia da Constituição. Aplicabilidade das normas constitucionais. Interpretação das normas constitucionais. Mutação constitucional."},{"disciplina":"Direito Constitucional","texto":"Poder constituinte. Características. Poder constituinte originário. Poder constituinte derivado."},{"disciplina":"Direito Constitucional","texto":"Direitos e garantias fundamentais. Direitos e deveres individuais e coletivos. Habeas corpus, mandado de segurança, mandado de injunção e habeas data. Direitos sociais. Direitos políticos. Partidos políticos. Ente estatal titular de direitos fundamentais."},{"disciplina":"Direito Constitucional","texto":"Organização do Estado. Organização políticoadministrativa. Estado federal brasileiro. União. Estados federados. Municípios. Distrito Federal. Territórios. Intervenção federal. Intervenção dos estados nos municípios."},{"disciplina":"Direito Constitucional","texto":"Administração pública. Disposições gerais. Servidores públicos."},{"disciplina":"Direito Constitucional","texto":"Organização dos poderes no Estado. Mecanismos de freios e contrapesos. Poder Legislativo. Poder Executivo. Poder Judiciário."},{"disciplina":"Direito Constitucional","texto":"Funções essenciais à justiça. Ministério Público. Advocacia pública. Defensoria Pública."},{"disciplina":"Direito Constitucional","texto":"Controle de constitucionalidade. Sistemas gerais e sistema brasileiro. Controle incidental ou concreto. Controle abstrato de constitucionalidade. Exame in abstractu da constitucionalidade de proposições legislativas. Ação declaratória de constitucionalidade. Ação direta de inconstitucionalidade. Arguição de descumprimento de preceito fundamental."},{"disciplina":"Direito Constitucional","texto":"Defesa do Estado e das instituições democráticas. Estado de defesa e estado de sítio. Forças armadas. Segurança pública."},{"disciplina":"Direito Constitucional","texto":"Sistema Tributário Nacional. Princípios gerais. Limitações do poder de tributar. Impostos da União, dos estados e dos municípios. Repartição das receitas tributárias."},{"disciplina":"Direito Constitucional","texto":"Finanças públicas. Normas gerais. Orçamentos."},{"disciplina":"Direito Constitucional","texto":"Ordem econômica e financeira. Princípios gerais da atividade econômica. Política urbana, agrícola e fundiária e reforma agrária."},{"disciplina":"Direito Financeiro e Tributário","texto":"Finanças públicas na Constituição Federal de 1988. Orçamento: conceito e espécies, natureza jurídica, princípios orçamentários. Normas gerais de direito financeiro. Fiscalização e controle interno e externo dos orçamentos."},{"disciplina":"Direito Financeiro e Tributário","texto":"Despesa pública. Conceito e classificação; disciplina constitucional dos precatórios. Receita pública. Conceito, ingressos e receitas. Classificação: receitas originárias e receitas derivadas."},{"disciplina":"Direito Financeiro e Tributário","texto":"Sistema Tributário Nacional. Limitações constitucionais ao poder de tributar. Repartição de competências na federação brasileira. Delegação de arrecadação. Discriminação constitucional das rendas tributárias. Legislação sobre o sistema tributário brasileiro. Definição de tributo e espécies de tributos."},{"disciplina":"Direito Financeiro e Tributário","texto":"Fontes do direito tributário. Conceito de fonte; fontes formais do direito tributário. Legislação tributária: leis, tratados, convenções internacionais, normas complementares. Vigência da legislação tributária. Aplicação da legislação tributária. Interpretação e integração da legislação tributária."},{"disciplina":"Direito Financeiro e Tributário","texto":"Obrigação principal e acessória: fato gerador; sujeitos ativo e passivo; capacidade tributária; domicílio tributário; responsabilidade tributária; solidariedade tributária; responsabilidade dos sucessores; responsabilidade por infrações."},{"disciplina":"Direito Financeiro e Tributário","texto":"Crédito tributário. Constituição, lançamento, modalidades e suspensão. Compensação, restituição, transação, remissão, prescrição e decadência. Conversão de depósito em renda. Consignação em pagamento. Decisão administrativa irreformável e decisão judicial passada em julgado. Restituição do tributo transferido; restituição de juros e multas; correção monetária."},{"disciplina":"Direito Financeiro e Tributário","texto":"Competência tributária. Não exercício da competência. Competência residual e extraordinária. Limitações da competência. Princípios da legalidade e da tipicidade. Princípio da anualidade. Proibição de tributos interlocais. Imunidade e isenção. Uniformidade tributária. Tributação das concessionárias. Sociedades mistas e fundações. Imunidade recíproca. Extensão da imunidade às autarquias."},{"disciplina":"Direito Financeiro e Tributário","texto":"Obrigação principal e acessória: fato gerador; sujeitos ativo e passivo; capacidade tributária; domicílio tributário; responsabilidade tributária; solidariedade tributária; substituição tributária; responsabilidade dos sucessores; responsabilidade de terceiros; responsabilidade por infrações."},{"disciplina":"Direito Financeiro e Tributário","texto":"Crédito tributário. Constituição. Lançamento e suas modalidades. Causas de suspensão, extinção e exclusão do crédito tributário. Garantias e privilégios do crédito tributário."},{"disciplina":"Direito Administrativo","texto":"Conceito e fontes do direito administrativo. Regime jurídicoadministrativo. Conceito. Conteúdo: supremacia do interesse público sobre o privado e indisponibilidade, pela administração, dos interesses públicos."},{"disciplina":"Direito Administrativo","texto":"Administração pública. Princípios expressos e implícitos da administração pública. Organização, descentralização, desconcentração, órgãos públicos. Administração pública em sentido amplo e em sentido estrito. Administração pública em sentido objetivo e em sentido subjetivo."},{"disciplina":"Direito Administrativo","texto":"Administração indireta e entidades paralelas."},{"disciplina":"Direito Administrativo","texto":"Atos administrativos. Conceitos, requisitos, elementos, pressupostos e classificação. Fato e ato administrativo. Atos administrativos em espécie. Formação do ato administrativo: elementos, procedimento administrativo. O silêncio no direito administrativo. Validade, eficácia e autoexecutoriedade do ato administrativo. Atos administrativos simples, complexos e compostos."},{"disciplina":"Direito Administrativo","texto":"Atos administrativos unilaterais, bilaterais e multilaterais. Atos administrativos gerais e individuais. Atos administrativos vinculados e discricionários. Mérito do ato administrativo, discricionariedade. Ato administrativo inexistente. Teoria das nulidades no direito administrativo. Atos administrativos nulos e anuláveis. Vícios do ato administrativo. Teoria dos motivos determinantes."},{"disciplina":"Direito Administrativo","texto":"Poderes da administração pública. Hierarquia: poder hierárquico e suas manifestações. Poder disciplinar. Poder de polícia. Liberdades públicas e poder de polícia."},{"disciplina":"Direito Administrativo","texto":"Intervenção do Estado sobre a propriedade privada. Intervenção do Estado no domínio econômico."},{"disciplina":"Direito Administrativo","texto":"Bens públicos. Regime jurídico. Aquisição e alienação dos bens públicos. Formas de utilização dos bens públicos pelos particulares."},{"disciplina":"Direito Administrativo","texto":"Licitações: modalidades e procedimentos."},{"disciplina":"Direito Administrativo","texto":"Contratos administrativos. Modalidades. Tipos. Procedimento. Anulação e revogação."},{"disciplina":"Direito Administrativo","texto":"Convênios e consórcios administrativos."},{"disciplina":"Direito Administrativo","texto":"Parceria público-privada. Lei nº 11.079/2004 e disposições doutrinárias. Conceito. Delegação: concessão, permissão e autorização. Lei nº 8.987/1995."},{"disciplina":"Direito Administrativo","texto":"Agentes públicos: espécies e classificação. Cargo, emprego e função públicos. Formas de provimento e vacância dos cargos públicos. Responsabilidade civil, penal e administrativa."},{"disciplina":"Direito Administrativo","texto":"Processo administrativo. Lei nº 9.784/1999. Processo administrativo disciplinar."},{"disciplina":"Direito Administrativo","texto":"Poderes e deveres da administração pública. Poder regulamentar. Dever de agir. Dever de eficiência. Dever de probidade. Dever de prestação de contas. Uso e abuso do poder."},{"disciplina":"Direito Civil","texto":"Lei de Introdução às Normas do Direito brasileiro. Vigência, aplicação, obrigatoriedade, interpretação e integração das leis. Conflito das leis no tempo. Eficácia das leis no espaço."},{"disciplina":"Direito Civil","texto":"Pessoas naturais. Conceito. Existência da pessoa natural. Personalidade. Capacidade. Direitos da personalidade. Nome civil. Estado civil. Domicílio. Ausência."},{"disciplina":"Direito Civil","texto":"Pessoas jurídicas. Disposições gerais. Conceito e elementos caracterizadores. Constituição. Extinção. Capacidade e direitos da personalidade. Sociedades de fato. Associações. Sociedades. Fundações. Entes despersonalizados. Desconsideração da personalidade jurídica. Responsabilidade da pessoa jurídica e dos sócios."},{"disciplina":"Direito Civil","texto":"Bens. Diferentes classes. Bens corpóreos e incorpóreos. Bens no comércio e fora do comércio. Bens considerados em si mesmos. Bens reciprocamente considerados. Bens públicos."},{"disciplina":"Direito Civil","texto":"Negócio jurídico. Disposições gerais. Classificação e interpretação. Elementos. Representação. Condição, termo e encargo. Defeitos do negócio jurídico. Existência, validade, eficácia. Invalidade do negócio jurídico. Simulação."},{"disciplina":"Direito Civil","texto":"Obrigações. Características. Elementos Princípios. Boa-fé. Obrigação complexa (a obrigação como um processo). Modalidades das obrigações. Obrigações de dar. Obrigações de fazer e de não fazer. Obrigações alternativas e facultativas. Obrigações divisíveis e indivisíveis. Obrigações solidárias. Obrigações civis e naturais, de meio, de resultado e de garantia."},{"disciplina":"Direito Civil","texto":"Obrigações de execução instantânea, diferida e continuada. Obrigações puras e simples, condicionais, a termo e modais. Obrigações líquidas e ilíquidas. Obrigações principais e acessórias. Transmissão das obrigações. Cessão de crédito. Assunção de dívida. Adimplemento e extinção das obrigações. Inadimplemento das obrigações."},{"disciplina":"Direito Civil","texto":"Contratos. Princípios. Classificação. Contratos em geral. Disposições gerais. Interpretação. Extinção."},{"disciplina":"Direito Civil","texto":"Atos unilaterais. Promessa de recompensa. Gestão de negócios. Pagamento indevido. Enriquecimento sem causa."},{"disciplina":"Direito Civil","texto":"Posse. Posse e sua classificação. Aquisição da posse. Efeitos da posse. Perda da posse."},{"disciplina":"Direito Civil","texto":"Direitos reais. Disposições gerais. Propriedade. Propriedade em geral. Aquisição da propriedade imóvel. Aquisição da propriedade móvel. Perda da propriedade. Direitos de vizinhança. Propriedade resolúvel."},{"disciplina":"Direito Civil","texto":"Usufruto. Disposições gerais. Direitos do usufrutuário. Deveres do usufrutuário. Extinção do usufruto."},{"disciplina":"Direito Civil","texto":"Direitos reais de garantia. Características. Princípios. Penhor, hipoteca e anticrese."},{"disciplina":"Direito Civil","texto":"Lei nº 6.015/1973 e suas alterações (registros públicos). Registros, presunção de fé pública, prioridade, especialidade, legalidade, continuidade, transcrição, inscrição e averbação. Procedimento de dúvida."},{"disciplina":"Direito Processual Civil","texto":"Lei nº 13.105/2015 e suas alterações (Código de Processo Civil). Normas processuais civis. Função jurisdicional. Ação. Conceito, natureza, elementos e características. Condições da ação. Classificação. Pressupostos processuais. Preclusão. Sujeitos do processo. Capacidade processual e postulatória. Deveres das partes e procuradores. Procuradores. Sucessão das partes e dos procuradores."},{"disciplina":"Direito Processual Civil","texto":"Litisconsórcio. Intervenção de terceiros. Poderes, deveres e responsabilidade do juiz. Ministério Público. Advocacia pública. Defensoria Pública. Atos processuais. Forma dos atos. Tempo e lugar. Prazos. Comunicação dos atos processuais. Nulidades. Distribuição e registro. Valor da causa. Tutela provisória. Tutela de urgência. Disposições gerais. Formação, suspensão e extinção do processo."},{"disciplina":"Direito Processual Civil","texto":"Processo de conhecimento e cumprimento de sentença. Procedimento comum. Disposições gerais. Petição inicial. Improcedência liminar do pedido. Audiência de conciliação ou de mediação. Contestação, reconvenção e revelia. Audiência de instrução e julgamento. Providências preliminares e do saneamento. Julgamento conforme o estado do processo. Provas. Sentença e coisa julgada."},{"disciplina":"Direito Processual Civil","texto":"Cumprimento da sentença. Disposições gerais. Cumprimento. Liquidação. Procedimentos especiais. Procedimentos de jurisdição voluntária. Processos de execução. Processos nos tribunais e meios de impugnação das decisões judiciais. Livro complementar. Disposições finais e transitórias."},{"disciplina":"Direito Processual Civil","texto":"Suspensão de liminar e de sentença."},{"disciplina":"Direito Processual Civil","texto":"Intervenção anômala da fazenda pública."},{"disciplina":"Economia","texto":"Microeconomia. Teoria da demanda. Preferências e função utilidade. Curvas de indiferença. Restrição orçamentária. Equilíbrio do consumidor. Curva de demanda. Bens substitutos e bens complementares. Elasticidades. Elasticidade-preço da demanda e seus determinantes. Efeito da mudança no preço de um bem sobre a receita total. Elasticidade renda da demanda. Elasticidade cruzada da demanda."},{"disciplina":"Economia","texto":"Classificação de bens de acordo com as elasticidades. Efeito-renda e efeito-substituição. Teoria da oferta. Função de produção. Fatores de produção. Produção de longo prazo versus produção de curto prazo, produto médio e produtividade marginal. Lei dos rendimentos decrescentes e rendimentos de escala. Custos de produção. Minimização de custos. Função custo total, custo médio e custo marginal."},{"disciplina":"Economia","texto":"Custos de longo prazo versus custos de curto prazo, custos fixos e custos variáveis. Maximização de lucro. Curva de oferta sob concorrência perfeita e equilíbrio médio marginal. Elasticidade-preço da oferta e seus determinantes. Equilíbrio de mercado. Equilíbrio sob concorrência perfeita, preço de equilíbrio e quantidade transacionada. Mudanças de equilíbrio."},{"disciplina":"Economia","texto":"Excedente do consumidor e excedente do produtor. Políticas de fixação de preços. Preço máximo e preço mínimo. Perdas de excedente, peso morto. Estruturas de mercado. Concorrência perfeita, concorrência imperfeita, monopólio e oligopólio: definição e caracterização. Equilíbrio de mercado sob monopólio. Oligopólios e cartelização. Concorrência imperfeita e preço-prêmio."},{"disciplina":"Economia","texto":"Dinâmica de determinação de preços e margem de lucro. Teoria dos jogos. Definições básicas: agentes (jogadores), ações, estratégia, resultados (payoffs). Equilíbrios. Equilíbrio em estratégia dominante. Equilíbrio de Nash. Dilema dos prisioneiros."},{"disciplina":"Economia","texto":"Economia do setor público. O Estado e as funções econômicas governamentais. Função estabilizadora, alocativa e distributiva. Necessidades públicas e formas de atuação dos governos. Falhas de mercado e papel do Estado na sua solução. Externalidades. Bens públicos. Assimetria de informações. Estado regulador e produtor. Tributação. Definição e tipos de tributos."},{"disciplina":"Economia","texto":"Imposto unitário e imposto ad valorem. Impostos regressivos e progressivos. Imposto sobre valor agregado (IVA). Imposto sobre patrimônio. Imposto sobre renda. Evolução da participação do setor público na atividade econômica."},{"disciplina":"Legislação","texto":"Lei nº 14.133/2021 (Nova Lei de Licitações)."},{"disciplina":"Legislação","texto":"Lei nº 9.984/2000 (cria a Agência Nacional de Águas – ANA)."},{"disciplina":"Legislação","texto":"Normas regulamentadoras da ANA. NR1 – Resolução ANA nº 79/2021 (resíduos sólidos e limpeza urbana). NR3 – Resolução ANA nº 161/2023 (água e esgoto). NR4 – Resolução ANA nº 177/2024 (agências reguladoras do saneamento). NR5 – Resolução ANA nº 178/2024 (água e esgoto). NR6 – Resolução ANA nº 183/2024 (água e esgoto). NR10 – Resolução ANA nº 228/2024 (água e esgoto)."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Orçamento segundo a Constituição da República de 1988 e na Lei de Responsabilidade Fiscal (LRF). Plano plurianual – PPA, lei de diretrizes orçamentárias e financeiras – LDO, lei orçamentária anual – LOA."},{"disciplina":"Regulação","texto":"Abordagem dos custos de transação."},{"disciplina":"Regulação","texto":"Falhas de mercado."},{"disciplina":"Regulação","texto":"Assimetria de informação."},{"disciplina":"Regulação","texto":"Falhas de governo."},{"disciplina":"Regulação","texto":"Seleção adversa e risco moral."},{"disciplina":"Regulação","texto":"Regulação por incentivos; mutabilidade dos contratos de concessão e PPPs."},{"disciplina":"Regulação","texto":"Reequilíbrio econômico-financeiro."},{"disciplina":"Regulação","texto":"Diferenças entre taxa, tarifa e contraprestação pública."},{"disciplina":"Regulação","texto":"Diferença entre revisão e reajuste."},{"disciplina":"Gestão de Custos","texto":"Sistemas de acumulação de custos. Produção por ordem. Produção contínua. Produção por processo. Produção conjunta. Coprodutos, subprodutos e sucatas."},{"disciplina":"Gestão de Custos","texto":"Apropriação dos custos à produção e aos serviços. Conceito e critérios de atribuição. Apropriação de materiais diretos, mão de obra direta e custos indiretos. Critérios de rateio. Taxa de aplicação dos custos indiretos de fabricação. Limitações e efeitos dos rateios sobre o custo e o resultado."},{"disciplina":"Gestão de Custos","texto":"Materiais e estoques. Custos com matéria-prima e material secundária. Custos diretos e indiretos com materiais. Métodos de controle de estoques de materiais."},{"disciplina":"Gestão de Custos","texto":"Métodos de custeio. Custeio por absorção. Custeio variável ou direto. Custeio baseado em atividades (ABC). Diferenciações conceituais. Apropriação dos custos em cada método. Impactos dos métodos de custeio sobre estoques, resultado e decisão."},{"disciplina":"Gestão de Custos","texto":"Margem de contribuição. Conceito. Cálculo unitário e total. Aplicações gerenciais. Mix de produtos e fator limitante."},{"disciplina":"Gestão de Custos","texto":"Relação custo-volume-lucro. Fundamentos. Hipóteses do modelo. Aplicações na análise gerencial. Limitações do modelo."},{"disciplina":"Gestão de Custos","texto":"Análise de custos para tomada de decisão. Formação de preços com base em custos. Aceitação ou rejeição de pedidos especiais. Decisão de fabricar ou comprar. Decisão de continuar, ampliar, reduzir ou descontinuar produtos, serviços, departamentos ou segmentos. Análise de rentabilidade por produto, cliente, canal, área ou unidade."},{"disciplina":"Gestão de Custos","texto":"Formas de controle dos custos e avaliação de desempenho. Controle por responsabilidade. Indicadores de desempenho relacionados a custos. Custos e orçamento. Custos e planejamento operacional."},{"disciplina":"Bloco I","texto":"Resíduos sólidos e contaminação de solos e águas subterrâneas. Qualidade do solo e da água subterrânea. Etapas de gerenciamento de áreas contaminadas. Noções de metodologias de diagnóstico e de reabilitação de solos e águas subterrâneas contaminados."},{"disciplina":"Bloco I","texto":"Recursos hídricos e efluentes líquidos. Abastecimento de água. Tratamento de água: processos convencionais e processos avançados, com ênfase em carvão ativado e processos de separação por membranas. Qualidade da água: parâmetros de qualidade e padrões de potabilidade. Poluição hídrica: por matéria orgânica, tóxica, por nutrientes, por óleo, por microrganismos patogênicos e térmica."},{"disciplina":"Bloco I","texto":"Legislação: classificação dos corpos de água superficiais e descarga de efluentes em corpos receptores. Gestão, processos e tecnologias de tratamento de efluentes líquidos para descarte e(ou) reúso (processos físicos, químicos e biológicos). Conservação da água: monitoramento do consumo, medição setorizada, indicadores de consumo, eliminação de desperdícios e perdas. Reúso interno e externo."},{"disciplina":"Bloco I","texto":"Emissões atmosféricas e mudanças climáticas. Principais poluentes atmosféricos e suas características. Principais fontes de emissões na indústria do petróleo. Qualidade do ar: conceitos e padrões. Principais tecnologias de controle e abatimento de emissões. Noções de efeito estufa; principais gases de efeito estufa. Noções de potencial de aquecimento global e CO2 equivalente."},{"disciplina":"Bloco I","texto":"Classificação de emissões de GEE (escopos 1, 2 e 3). Inventário de emissões. Ações de redução de emissões de GEE no setor de óleo e gás. Risco climático, vulnerabilidade, resiliência e medidas adaptativas. Acordo de Paris. Transição energética para baixo carbono: conceito; conceito de captura, uso e armazenamento de carbono – CCUS. Noções de mercado e precificação de carbono."},{"disciplina":"Bloco I","texto":"Prevenção da poluição e uso racional dos recursos naturais na indústria do petróleo e energia. Prevenção da poluição: aspectos comportamentais e aspectos tecnológicos. Ecologia industrial, economia circular e análise de ciclo de vida. Conservação de energia: monitoramento do consumo; medição setorizada; indicadores de consumo; eliminação de desperdícios e perdas."},{"disciplina":"Bloco I","texto":"Legislação ambiental aplicada. Constituição Federal de 1988 (artigo 225). Lei Complementar nº 140/2011 (normas de cooperação entre União, estados e municípios, incluindo a competência para o licenciamento ambiental). Lei federal nº 12.651/2012 e suas alterações (Novo Código Florestal). Lei federal nº 11.284/2006 (Lei da Mata Atlântica)."},{"disciplina":"Bloco I","texto":"Lei federal nº 6.938/1981 e suas alterações (Política Nacional de Meio Ambiente). Lei federal nº 9.605/1998 e suas alterações (Lei de Crimes Ambientais). Lei federal nº 9.966/2000 e suas alterações (prevenção de poluição por óleo). Lei federal nº 9.433/1997 e suas alterações (Política Nacional de Recursos Hídricos)."},{"disciplina":"Bloco I","texto":"Lei federal nº 11.445/2007 e suas alterações (Diretrizes Nacionais de Saneamento Básico). Lei federal nº 12.187/2009 e suas alterações (Política Nacional sobre Mudança do Clima). Lei federal nº12.305/2010 e suas alterações (Política Nacional de Resíduos Sólidos). Lei federal nº 12.334/2010 e suas alterações (Política Nacional de Segurança de Barragens)."},{"disciplina":"Bloco I","texto":"Decreto federal nº 8.437/2015 (tipologias de empreendimentos e atividades cujo licenciamento ambiental é de competência da União). Decreto federal nº 8.127/2013 (Plano Nacional de Contingência). Decreto federal nº 6.514/2008 (infrações e sanções administrativas ao meio ambiente). Resolução CONAMA nº 1/1986 (EIA/RIMA). Resolução CONAMA nº 237/1997 (licenciamento ambiental)."},{"disciplina":"Bloco I","texto":"Resolução CONAMA nº 6/1986 (publicação de licenças). Resolução CONAMA nº 9/1987 (audiências públicas). Resolução CONAMA nº 357/2005 (classificação dos corpos de água e diretrizes ambientais para seu enquadramento). Resolução CONAMA nº 393/2007 (descarte contínuo de água de processo ou produção). Resolução CONAMA nº 430/2011 (condições e padrões de lançamento de efluentes)."},{"disciplina":"Bloco I","texto":"Resolução CONAMA nº 436/2011 (limites máximos de emissão de poluentes atmosféricos para fontes fixas instaladas ou com pedido de licença de instalação anteriores a 2 de janeiro de 2007). Resolução CONAMA nº 382/2006 (limites máximos de emissão de poluentes atmosféricos para fontes fixas). Resolução CONAMA nº 381/2006 (requisitos mínimos para a realização de auditoria ambiental)."},{"disciplina":"Bloco I","texto":"Portaria MMA nº 422/2011 (licenciamento ambiental federal de atividades e empreendimentos de exploração e produção e gás natural – E&P no ambiente marinho e em zona de transição terra-mar)."},{"disciplina":"Bloco II","texto":"Noções de ecologia. Ecossistemas: conceitos, estrutura, classificação, tipos de ecossistemas brasileiros. Energia dos sistemas ecológicos. Ciclos biogeoquímicos. Fatores limitantes e o ambiente. Seleção natural. Interações ecológicas. Sucessão ecológica. Dinâmica das populações. Ações humanas sobre sistemas ecológicos. Problemas ambientais, suas causas e sustentabilidade."},{"disciplina":"Bloco II","texto":"Licenciamento ambiental. Procedimentos para o licenciamento ambiental. Legislação aplicável. Estudos ambientais: critérios para sua exigência e métodos e etapas de elaboração. Processos de licenciamento ambiental: tipos, etapas e fases do licenciamento, audiências e reuniões públicas, compensação ambiental, atendimento de condicionantes e manutenção de licenças."},{"disciplina":"Bloco II","texto":"Órgãos ambientais licenciadores e intervenientes."},{"disciplina":"Bloco II","texto":"Gestão ambiental e de saúde e segurança ocupacional. Requisitos de sistema de gestão ambiental segundo as normas ABNT NBR ISO 14.001:2015, NBR ISO 14.002:2022 e NBR ISO 14.004:2018. Avaliação de desempenho ambiental segundo a norma ABNT NBR ISO 14.031:2015. Sistemas de gestão de saúde e segurança ocupacional segundo a norma ISO 45.001:2025 Emenda 1:2025."},{"disciplina":"Bloco II","texto":"Planejamento e resposta a emergências. Conceitos básicos e ferramentas de análises de riscos qualitativas e quantitativas (APR, AQR, E-SE, AE, AF etc.). Normas técnicas da ABNT sobre manuseio e armazenamento de produtos químicos, incluindo FISPQ. Legislação aplicada à contingência. Lei nº 9.966/2000. Resoluções CONAMA nº 398/2008, nº 472/2015 e nº 482/2016."},{"disciplina":"Bloco III","texto":"Noções de ciências do ambiente. Noções de geologia. Noções de pedologia. Noções de química ambiental. Noções de hidrogeologia. Noções de geografia/cartografia. Noções de hidrologia. Noções de limnologia. Noções de meteorologia e climatologia."},{"disciplina":"Bloco III","texto":"Planejamento ambiental, planejamento territorial, urbanismo, vocação e uso do solo."},{"disciplina":"Bloco III","texto":"Noções de economia ambiental e desenvolvimento sustentável. Política ambiental. Benefícios da política ambiental. Desenvolvimento sustentável: conceitos, objetivos e diretrizes. Principais objetivos mundiais de desenvolvimento sustentável. Fundamentos teóricos e metodológicos da valoração econômica do meio ambiente. Avaliação do uso de recursos naturais. Análise econômica de recursos naturais."},{"disciplina":"Bloco III","texto":"Análise, avaliação e gerenciamento de riscos. Risco tecnológico: identificação de cenários. Avaliação de frequência. Avaliação de consequências. Avaliação quantitativa de riscos. Critérios de risco individual e social: conceitos e indicadores. Plano de gerenciamento de riscos. Risco ambiental: identificação de cenários."},{"disciplina":"Bloco III","texto":"Comportamento e dispersão do óleo em meio hídrico, sensibilidade dos receptores. Avaliação de risco ambiental. Técnicas de planejamento de resposta. Planos de emergência. Programa de gerenciamento de riscos)."},{"disciplina":"Legislação","texto":"Normas regulamentadoras da ANA. NR1 – Resolução ANA nº 79/2021 (resíduos sólidos e limpeza urbana). NR3 – Resolução ANA nº 161/2023 (água e esgoto). NR4 – Resolução ANA nº 177/2024 (agências reguladoras do saneamento). NR5 – Resolução ANA nº 178/2024 (água e esgoto). NR6 – Resolução ANA nº 183/2024 (água e esgoto). NR7 – Resolução ANA nº 187/2024 (resíduos sólidos e limpeza urbana)."},{"disciplina":"Legislação","texto":"NR8 – Resolução ANA nº 192/2024 (água e esgoto). NR9 – Resolução ANA nº 211/2024 (água e esgoto). NR10 – Resolução ANA nº 228/2024 (água e esgoto). NR11 – Resolução ANA nº 230/2024 (água e esgoto). NR12 – Resolução ANA nº 245/2025 (drenagem). NR13 – Resolução ANA nº 271/2025 (água e esgoto). NR14 – Resolução ANA nº 276/2025 (resíduos sólidos e limpeza urbana)."},{"disciplina":"Administração Pública e Regulação","texto":"Serviços públicos. Conceito, classificação, regulamentação e controle; forma, meios e requisitos. Delegação. Concessão, permissão, autorização."},{"disciplina":"Administração Pública e Regulação","texto":"Regulação. Agências reguladoras. Papel regulador do Estado. Pressupostos, objetivos e instrumentos."},{"disciplina":"Administração Pública e Regulação","texto":"Poder de mercado."},{"disciplina":"Administração Pública e Regulação","texto":"Assimetria de informação."},{"disciplina":"Administração Pública e Regulação","texto":"Regulação por incentivos."},{"disciplina":"Administração Pública e Regulação","texto":"Essential facilities."},{"disciplina":"Engenharia Civil","texto":"Planejamento de projetos e obras de engenharia. Programação e controle. Viabilidade, planejamento e controle das construções. Técnico, físico‐financeiro e econômico. Segurança e higiene do trabalho."},{"disciplina":"Engenharia Civil","texto":"Projeto e execução de edificações. Estudos preliminares. Terraplenagem e locação da obra. Canteiro de obras. Fundações. Escavações. Contenção de taludes e escoramentos. Estruturas metálicas, de madeira e de concreto; formas; armação; alvenaria estrutural; estruturas pré‐fabricadas. Instalações prediais. Elétricas, hidráulicas, de esgoto. Alvenarias e revestimentos. Esquadrias. Forros. Pisos."},{"disciplina":"Engenharia Civil","texto":"Coberturas. Impermeabilização. Noções de projeto assistido por computador (CAD)."},{"disciplina":"Engenharia Civil","texto":"Hidráulica e saneamento básico. Redes de água e esgoto. Tratamento de água e esgoto. Hidráulica aplicada e hidrologia."},{"disciplina":"Engenharia Civil","texto":"Materiais de construção civil. Aglomerantes e agregados. Materiais betuminosos. Propriedades físicas e mecânicas. Ensaios. Sistemas construtivos."},{"disciplina":"Engenharia Civil","texto":"Mecânica dos solos. Origem e formação dos solos. Processos erosivos. Índices físicos. Caracterização e propriedades dos solos. Pressões nos solos. Prospecção geotécnica. Permeabilidade dos solos; percolação nos solos. Compactação, compressibilidade e adensamento dos solos; estimativa de recalques. Resistência dos solos ao cisalhamento."},{"disciplina":"Engenharia Civil","texto":"Projeto e execução de barragens e hidrelétricas. Principais tipos. Elementos. Mecanismos de ruptura de barragens."},{"disciplina":"Engenharia Civil","texto":"Resistência dos materiais e análise estrutural. Deformações e análise de tensões. Flexão simples; flexão composta; torção; cisalhamento e flambagem. Esforços em uma seção. Esforço normal; esforço cortante; torção e momento fletor. Diagrama de esforços solicitantes. Estruturas isostáticas. Vigas simples, vigas Gerber, quadros, arcos e treliças. Estruturas hiperestáticas."},{"disciplina":"Engenharia Civil","texto":"Dimensionamento de estruturas em concreto. Características mecânicas e reológicas do concreto. Tipos de aço para concreto armado; fabricação do aço; características mecânicas do aço; estados limites; aderência; ancoragem e emendas em barras de armação. Dimensionamento de elementos estruturais: pilares, lajes e vigas. Detalhamento de armação em concreto armado. Concreto protendido."},{"disciplina":"Engenharia Civil","texto":"Noções de tipos de protensão. Concreto pré-moldado. Dimensionamento, detalhamento e montagem."},{"disciplina":"Engenharia Civil","texto":"Engenharia legal. Engenharia de avaliações. Métodos; depreciação; desapropriações. Fiscalização. Ensaios de recebimento da obra. Acompanhamento da aplicação de recursos (medições, emissão de fatura, cálculos de reajustamento). Controle de execução de obras e serviços. Análise de documentação técnica: diário de obra, documentos de legalização, ARTs, aditivos contratuais."},{"disciplina":"Engenharia Civil","texto":"Engenharia de custos. Levantamento de serviços e seus quantitativos. Orçamento analítico e sintético. Composição analítica de serviços. Cronograma físico‐financeiro. Cálculo de benefício e despesas indiretas (BDI). Cálculo de encargos sociais. Índices de atualização de custos na construção civil."},{"disciplina":"Engenharia Civil","texto":"Patologia de obras de engenharia civil. Patologia de edificações. Patologia de obras de terra. Patologia de obras hídricas."},{"disciplina":"Engenharia Civil","texto":"Princípios e fundamentos da engenharia de transportes. Planejamento e gestão integrada da infraestrutura de transporte: rodoviário, ferroviário, hidroviário, aeroportuário e portuário. Intermodalidade e logística integrada. Sustentabilidade e inovação tecnológica em transportes."},{"disciplina":"Engenharia Civil","texto":"Aspectos gerais do setor de gás canalizado. Cadeia produtiva do gás natural. Exploração e produção de gás natural, logística, transferência, transporte, carregamento e distribuição de gás natural. Produção do gás natural associado e não associado. Gás natural e biocombustíveis. Matriz energética: fontes renováveis e não renováveis. Transição energética."},{"disciplina":"Conhecimentos Específicos","texto":"Circuitos elétricos lineares. Elementos de circuitos. Leis de Kirchhoff. Métodos de análise nodal e das malhas. Análise de circuitos em CC e em CA (regime permanente senoidal). Princípio da superposição e equivalentes de Thévenin e de Norton. Solução de circuitos no domínio do tempo e da frequência. Quadripolos."},{"disciplina":"Conhecimentos Específicos","texto":"Eletromagnetismo. Princípios gerais. Campos eletrostático, magnetostático e eletromagnetostático. Campos elétricos em meio material: propriedades, condições de fronteira em meios diferentes. Forças devido aos campos magnéticos e momentos magnéticos. Ondas TEM. Reflexão e refração de ondas planas."},{"disciplina":"Conhecimentos Específicos","texto":"Eletrônica analógica, digital e de potência. Circuitos analógicos e dispositivos eletrônicos. Famílias de circuitos lógicos. Sistemas digitais: conversão de bases numéricas, portas lógicas, circuitos combinacionais, circuitos sequenciais e máquinas de estado. Conversores CC‐CC, CC‐CA, CA‐CC e CA‐CA. Conversão analógica‐digital e digital analógica."},{"disciplina":"Conhecimentos Específicos","texto":"Princípios de comunicações. Comunicações analógicas e digitais. Comutação analógica e digital."},{"disciplina":"Conhecimentos Específicos","texto":"Microcomputadores. Principais componentes. Organização."},{"disciplina":"Conhecimentos Específicos","texto":"Teoria de controle. Análise e síntese de sistemas lineares escalares, contínuos e discretos, nos domínios do tempo e da frequência. Métodos de análise de estabilidade. Representação de sistemas lineares por variáveis de estado. Noções de processamento de sinais."},{"disciplina":"Conhecimentos Específicos","texto":"Máquinas elétricas. Princípios de conversão eletromecânica de energia. Máquinas síncronas. Máquinas de indução. Máquinas CC. Transformadores."},{"disciplina":"Conhecimentos Específicos","texto":"Subestações e equipamentos elétricos. Arranjos típicos, malhas de terra e sistemas auxiliares. Equipamentos de manobra em alta tensão. Chaves e disjuntores. Para‐ raios. Transformador de potencial e de corrente. Relés e suas funções nos sistemas de energia. Princípios e características de operação, tipos básicos."},{"disciplina":"Conhecimentos Específicos","texto":"Circuitos trifásicos e análise de faltas em sistemas de energia elétrica. Tipos de ligação de cargas. Tensão, corrente, potência e fator de potência em circuitos equilibrados e desequilibrados. Representação de sistemas em “por unidade” (pu). Componentes simétricos e faltas simétricas e assimétricas."},{"disciplina":"Conhecimentos Específicos","texto":"Instalações elétricas em baixa tensão. Projeto de instalações prediais e industriais. Acionamentos elétricos. Motores elétricos de indução e diagramas de comando. Segurança em instalações elétricas."},{"disciplina":"Conhecimentos Específicos","texto":"Fiscalização. Acompanhamento da aplicação de recursos (medições, emissão de fatura etc.). Controle de execução de obras e serviços."},{"disciplina":"Administração Pública e Regulação","texto":"Agências reguladoras. Papel regulador do Estado. Pressupostos, objetivos e instrumentos. Agências reguladoras e princípio da legalidade. Órgãos reguladores no Brasil. Histórico, conceito, estrutura jurídica, funções, controle, e características das autarquias. Autonomia administrativa e poder normativo. Reforma do Estado e papel das agências reguladoras. Abordagens."},{"disciplina":"Administração Pública e Regulação","texto":"Teoria econômica da regulação, teoria da captura, teoria do agente principal. Formas de regulação. Regulação de preço; regulação de entrada; regulação de qualidade. Boas práticas regulatórias. Análise de impacto regulatório (AIR), avaliação de resultado regulatório (ARR), agenda regulatória e o processo de participação e controle social; falhas de mercado. Poder de mercado."},{"disciplina":"Administração Pública e Regulação","texto":"Assimetria de informação. Modelos de regulação. Custo do serviço, price cap, revenue cap. Regulação por incentivos. Essential facilities. Mutabilidade dos contratos de concessão e PPPs. Reequilíbrio econômico-financeiro. Diferenças entre taxa, tarifa e contraprestação pública."},{"disciplina":"Tecnologia da Informação","texto":"Banco de dados. Arquitetura de banco de dados: relacional (PostgreSQL 18.4, Oracle 26ai, SQLServer 2025), não relacional (orientado a documento, chave-valor, grafo, colunar, time series). Modelagem de banco de dados: físico, lógico e conceitual. Álgebra relacional, SQL/ANSI e linguagens procedurais embarcadas."},{"disciplina":"Tecnologia da Informação","texto":"Engenharia de software. Conceitos básicos sobre engenharia de software. Disciplinas de engenharia de software. Análise de requisitos funcionais e não-funcionais. Análise, projeto e modelagem orientada a objetos. UML. Modelagem de dados. Modelagem relacional. Qualidade de software. ISO/IEC 25010 (SQuaRE). Métricas de qualidade de software. Análise de pontos de função. Aplicações cloud native."},{"disciplina":"Tecnologia da Informação","texto":"Programação funcional e orientação a objetos."},{"disciplina":"Tecnologia da Informação","texto":"Segurança da informação. Confiabilidade, integridade, disponibilidade, autenticidade e não repúdio. Mecanismos de segurança. Criptografia: conceitos básicos e aplicações, principais algoritmos de criptografia. Assinatura digital. Garantia de integridade. Controle de acesso. Certificação digital. Tecnologias de segurança: firewalls, sistema de detecção e prevenção de intrusões, antivírus."},{"disciplina":"Tecnologia da Informação","texto":"Gestão de riscos e continuidade de negócio. Segurança cibernética. Gestão de identidades e acesso: autenticação e autorização, single sign-on (SSO), security assertion markup language (SAML), OAuth2 e OpenId Connect. Privacidade e segurança por padrão. Principais tipos de ataques e vulnerabilidades. Controles e testes de segurança para aplicações web e web services."},{"disciplina":"Tecnologia da Informação","texto":"Assinatura e certificação digital, criptografia e proteção de dados em trânsito e em repouso. Segurança em nuvens e de contêineres."},{"disciplina":"Tecnologia da Informação","texto":"Infraestrutura de serviços, servidores, virtualização e serviços em cloud."},{"disciplina":"Tecnologia da Informação","texto":"Infraestrutura de TIC. Redes de computadores. Endereçamento e protocolos da família TCP/IP. Classificação de redes: PAN, LAN, MAN, WAN."},{"disciplina":"Tecnologia da Informação","texto":"Gerenciamento de projetos e práticas ágeis. Ciclo de vida de projetos de TI. Metodologia de gestão de projetos: PMBOK 8ª edição, ITIL 4, Agile, Scrum, Kanban. Ferramentas de gestão de projetos: MS Project, JIRA, TRELLO. Gerenciamento de escopo, tempo, custo, qualidade, recursos humanos, comunicações, riscos e aquisições."},{"disciplina":"Tecnologia da Informação","texto":"Governança de TI. Conceitos e princípios de governança de TIC. Frameworks e modelos de governança. COBIT 5. Alinhamento estratégico entre TI e negócios. Planejamento estratégico de TI."},{"disciplina":"Tecnologia da Informação","texto":"Gerenciamento de serviços de TI (ITIL 2019). Noções de ITIL e seus processos. Gerenciamento de serviços: catálogo de serviços, níveis de serviço, gerenciamento de capacidade e disponibilidade. Gerenciamento de incidentes e problemas: gestão de mudanças, configurações e liberações."},{"disciplina":"Tecnologia da Informação","texto":"Gestão de configuração. DevOps. Modelo de versionamento, merge, branch, pipeline. CI/CD (continuous integration/continuous delivery). Mesh app and service architecture (MASA)."},{"disciplina":"Tecnologia da Informação","texto":"Contêineres. Noções de Docker e Kubernetes. Arquitetura da plataforma Docker. Instalação e configuração do Docker. Criação e manipulação de imagens Docker. Registry Docker. Gerência de contêineres com Docker. Rede no Docker. Volumes no Docker. Segurança no Docker. Noções de contêineres."},{"disciplina":"Orientações a Serviço","texto":"Microsserviços. Orquestração de serviços, API gateway. Padrões de microsserviços. Transações distribuídas."},{"disciplina":"Orientações a Serviço","texto":"Arquitetura de software. Interoperabilidade de sistemas. Arquitetura orientada a serviços. Web services. RESTful, SOAP."},{"disciplina":"Orientações a Serviço","texto":"Arquitetura. Camadas, modelo MVC. Arquitetura de aplicações para ambiente web."},{"disciplina":"Orientações a Serviço","texto":"Servidor web. BIG DATA & ANALYTICS, BUSINESS INTELLIGENCE: I BIG DATA & ANALYTICS:."},{"disciplina":"Orientações a Serviço","texto":"Dado, informação, conhecimento e inteligência. Dados estruturados e não estruturados. Dados abertos. Coleta, tratamento, armazenamento, integração e recuperação de dados."},{"disciplina":"Orientações a Serviço","texto":"Mineração de dados. Modelo de referência CRISP-DM. Técnicas para pré-processamento de dados. Técnicas e tarefas de mineração de dados. Classificação. Regras de associação. Análise de agrupamentos (clusterização). Detecção de anomalias. Modelagem preditiva. Aprendizado de máquina. Mineração de texto."},{"disciplina":"Orientações a Serviço","texto":"Big data. Conceito, premissas e aplicação. Tipos de dados: estruturados, semiestruturados e não estruturados. Conceitos dos três Vs. Fluxo de big data: ingestão, processamento e disponibilização. Armazenamento de big data. Pipeline de dados. Processamento distribuído. Noções de datalake. ETL × ELT."},{"disciplina":"Orientações a Serviço","texto":"Visualização e análise exploratória de dados."},{"disciplina":"Orientações a Serviço","texto":"Visualização de dados: BD individuais e cubos."},{"disciplina":"Orientações a Serviço","texto":"Técnicas de modelagem e otimização de bases de dados multidimensionais."},{"disciplina":"Orientações a Serviço","texto":"Mapeamento das fontes de dados: técnicas para coleta de dados."},{"disciplina":"Orientações a Serviço","texto":"Sistemas de suporte a decisão e gestão de conteúdo."},{"disciplina":"Orientações a Serviço","texto":"Visualização e análise exploratória de dados. Ferramentas de criação de dashboards (Power BI (atualização de maio de 2026), Google Looker e Pentaho 11). Storytelling. Elaboração de painéis e dashboard. Elaboração de relatórios analíticos. Python para visualização e análise exploratória de dados."},{"disciplina":"Língua Portuguesa","texto":"Marcas de textualidade: coesão, coerência e intertextualidade."},{"disciplina":"Língua Portuguesa","texto":"Estrutura da frase portuguesa: operações de deslocamento, substituição, modificação e correção. Problemas estruturais das frases. Norma culta. Pontuação e sinais gráficos. Organização sintática das frases: termos e orações. Ordem direta e inversa."},{"disciplina":"Língua Portuguesa","texto":"Semântica: sentido próprio e figurado; antônimos, sinônimos, parônimos e hiperônimos. Polissemia e ambiguidade. Os dicionários: tipos, organização de verbetes."},{"disciplina":"Língua Portuguesa","texto":"Ortografia e acentuação gráfica, crase."},{"disciplina":"Raciocínio Lógico Matemático","texto":"Diagramas lógicos, tabelas e gráficos."},{"disciplina":"Raciocínio Lógico Matemático","texto":"Álgebra básica: equações, sistemas e problemas do primeiro grau."},{"disciplina":"Raciocínio Lógico Matemático","texto":"Porcentagem e proporcionalidade direta e inversa."},{"disciplina":"Raciocínio Lógico Matemático","texto":"Sequências, reconhecimento de padrões, progressões aritmética e geométrica."},{"disciplina":"Raciocínio Lógico Matemático","texto":"Medidas de comprimento, área, volume."},{"disciplina":"Raciocínio Lógico Matemático","texto":"Princípios de contagem e noção de probabilidade."},{"disciplina":"Noções de Informática","texto":"Macros."},{"disciplina":"Noções de Informática","texto":"Integração com planilhas."},{"disciplina":"Noções de Informática","texto":"Navegação segura: cuidados no uso da Internet; ameaças; uso de senhas e criptografia; tokens e outros dispositivos de segurança; senhas fracas e fortes."},{"disciplina":"Noções de Informática","texto":"Transferência de arquivos e dados: upload, download, banda, velocidades de transmissão."},{"disciplina":"Noções de Informática","texto":"Aplicativos Google WorkSpace (Gmail, Google Docs, Google Sheets, Google Drive, Google Meet e Google Calendar)."},{"disciplina":"Conhecimentos Específicos","texto":"Administração por objetivos."},{"disciplina":"Conhecimentos Específicos","texto":"Indicadores de desempenho, diagnóstico empresarial e avaliação de empresas."},{"disciplina":"Conhecimentos Específicos","texto":"Gestão da qualidade."},{"disciplina":"Conhecimentos Específicos","texto":"Compras na Administração Pública e legislação pertinente."},{"disciplina":"Conhecimentos Específicos","texto":"Administração Financeira e Orçamentária, noções de custos."},{"disciplina":"Conhecimentos Específicos","texto":"Lei Federal Nº 14.133/2021 - Estabelece normas gerais de licitação e contratação para as Administrações Públicas diretas, autárquicas e fundacionais da União, dos Estados, do Distrito Federal e dos Municípios."},{"disciplina":"Língua Portuguesa","texto":"Interpretação de textos argumentativos, com destaque para métodos de raciocínio e tipologia argumentativa."},{"disciplina":"Língua Portuguesa","texto":"Processos de construção textual."},{"disciplina":"Língua Portuguesa","texto":"A progressão textual."},{"disciplina":"Língua Portuguesa","texto":"As marcas de textualidade: a coesão, a coerência e a intertextualidade."},{"disciplina":"Língua Portuguesa","texto":"A organização sintática e o emprego dos sinais de pontuação."},{"disciplina":"Língua Portuguesa","texto":"A linguagem denotativa e a conotativa."},{"disciplina":"Conhecimentos Específicos","texto":"Restos a Pagar e Regimes Contábeis da Administração Pública."},{"disciplina":"Conhecimentos Específicos","texto":"Demonstrações Contábeis do Setor Público (DCA, AGESAN – RS CNPJ: 32.466.876/0001-14 Rua Félix da Cunha, 1009, Sala 802, Moinhos de Vento – Porto Alegre/RS – CEP: 90570-001 Balanço Orçamentário, Balanço Financeiro, Balanço Patrimonial)."},{"disciplina":"Conhecimentos Específicos","texto":"Controle interno, externo e social."},{"disciplina":"Conhecimentos Específicos","texto":"Relatórios e Pareceres de Auditoria."},{"disciplina":"Conhecimentos Específicos","texto":"Ciclo orçamentário e execução financeira."},{"disciplina":"Conhecimentos Específicos","texto":"Créditos adicionais: suplementares, especiais e extraordinários."},{"disciplina":"Conhecimentos Específicos","texto":"Dívida pública e regras fiscais."},{"disciplina":"Conhecimentos Específicos","texto":"Lei das Licitações e Contratos (Lei 14.133/2021)."},{"disciplina":"Conhecimentos Específicos","texto":"Taxas de desconto e equivalência de capitais."},{"disciplina":"SUS","texto":"Sistema Único de Saúde (SUS). princípios, diretrizes, estrutura e organização. Políticas de saúde. Estrutura e funcionamento das instituições e suas relações com os serviços de saúde. Níveis progressivos de assistência à saúde. Direitos dos usuários do SUS. Participação e controle social. Legislação básica do SUS."},{"disciplina":"Conhecimentos Específicos","texto":"Metodologias de Gerenciamento de Projetos. Metodologia tradicional (cascata) baseada no PMBOK 7ª edição. Metodologias ágeis aplicadas a projetos e serviços de saúde."},{"disciplina":"Conhecimentos Específicos","texto":"Planejamento, monitoramento e execução de projetos. Planejamento de cronogramas, custos e recursos. Monitoramento da execução, indicadores e gestão de riscos."},{"disciplina":"Conhecimentos Específicos","texto":"Práticas educativas e qualificação em saúde. Planejamento e desenvolvimento de ações educativas em saúde. Organização de capacitações, oficinas e eventos técnicos para a qualificação de profissionais."},{"disciplina":"Conhecimentos Específicos","texto":"Fundamentos de eletricidade e circuitos elétricos."},{"disciplina":"Conhecimentos Específicos","texto":"Arquivologia e gestão documental."},{"disciplina":"Conhecimentos Específicos","texto":"Políticas públicas e gestão social."},{"disciplina":"Conhecimentos Específicos","texto":"Gestão de pessoas: clima, desempenho, engajamento, produtividade, bem‐estar e qualidade de vida no trabalho."},{"disciplina":"Conhecimentos Específicos","texto":"Saúde ocupacional (NR’s)."},{"disciplina":"Conhecimentos Específicos","texto":"Epidemiologia ocupacional."},{"disciplina":"Conhecimentos Específicos","texto":"Biossegurança."},{"disciplina":"Conhecimentos Específicos","texto":"Práticas educativas e qualificação em saúde. Planejamento e desenvolvimento de ações educativas em saúde. Organização de capacitações, oficinas e eventos técnicos para a qualificação de profissionais. Uso de tecnologias digitais e ambientes virtuais de aprendizagem em processos educativos. Experiências inovadoras em educação."},{"disciplina":"Conhecimentos Específicos","texto":"Ciência de dados aplicada à gestão pública e à saúde."},{"disciplina":"Conhecimentos sobre o SUS","texto":"Sistema Único de Saúde (SUS). Princípios, diretrizes, estrutura e organização. Políticas de saúde. Estrutura e funcionamento das instituições e suas relações com os serviços de saúde. Níveis progressivos de assistência à saúde. Direitos dos usuários do SUS. Participação e controle social. Legislação básica do SUS."},{"disciplina":"Conhecimentos Específicos","texto":"Saúde ocupacional (NRs)."},{"disciplina":"Conhecimentos sobre o SUS","texto":"Sistema Único de Saúde (SUS). princípios, diretrizes, estrutura e organização. Políticas de saúde. Estrutura e funcionamento das instituições e suas relações com os serviços de saúde. Níveis progressivos de assistência à saúde. Direitos dos usuários do SUS. Participação e controle social."},{"disciplina":"Conhecimentos sobre o SUS","texto":"Constituição Federal de 1988 (arts. 196 a 200)."},{"disciplina":"Conhecimentos Específicos","texto":"Noções de primeiros socorros."},{"disciplina":"Direito Financeiro e Econômico","texto":"Fiscalização e controle interno e externo dos orçamentos."},{"disciplina":"Direito Processual Civil","texto":"Poderes, deveres e responsabilidade do juiz, Ministério Público, Advocacia Pública e Defensoria Pública."},{"disciplina":"DESAFIOS DO ESTADO DE DIREITO: DEMOCRACIA E CIDADANIA","texto":"Meio ambiente."},{"disciplina":"EIXO TEMÁTICO 1 - GESTÃO GOVERNAMENTAL E GOVERNANÇA PÚBLICA: ESTRATÉGIA, PESSOAS, PROJETOS E PROCESSOS","texto":"Gestão por competências."},{"disciplina":"EIXO TEMÁTICO 1 - GESTÃO GOVERNAMENTAL E GOVERNANÇA PÚBLICA: ESTRATÉGIA, PESSOAS, PROJETOS E PROCESSOS","texto":"Qualidade de vida no trabalho."},{"disciplina":"EIXO TEMÁTICO 1 - GESTÃO GOVERNAMENTAL E GOVERNANÇA PÚBLICA: ESTRATÉGIA, PESSOAS, PROJETOS E PROCESSOS","texto":"Negociação."},{"disciplina":"EIXO TEMÁTICO 2 - GESTÃO GOVERNAMENTAL E GOVERNANÇA PÚBLICA: RISCOS, INOVAÇÃO, PARTICIPAÇÃO, LOGÍSTICA e PATRIMÔNIO","texto":"Controle social e cidadania."},{"disciplina":"EIXO TEMÁTICO 2 - GESTÃO GOVERNAMENTAL E GOVERNANÇA PÚBLICA: RISCOS, INOVAÇÃO, PARTICIPAÇÃO, LOGÍSTICA e PATRIMÔNIO","texto":"Controle interno."},{"disciplina":"EIXO TEMÁTICO 2 - GESTÃO GOVERNAMENTAL E GOVERNANÇA PÚBLICA: RISCOS, INOVAÇÃO, PARTICIPAÇÃO, LOGÍSTICA e PATRIMÔNIO","texto":"Controle externo."},{"disciplina":"EIXO TEMÁTICO 2 - GESTÃO GOVERNAMENTAL E GOVERNANÇA PÚBLICA: RISCOS, INOVAÇÃO, PARTICIPAÇÃO, LOGÍSTICA e PATRIMÔNIO","texto":"Processos participativos de gestão pública: conselhos de gestão, orçamento participativo, parceria entre governo e sociedade."},{"disciplina":"EIXO TEMÁTICO 3 – POLÍTICAS PÚBLICAS E NOÇÕES DE ESTATÍSTICA","texto":"Noções de Inferência Estatística: População e Amostra, Seleção de amostra, Estatística e Parâmetro, Distribuições amostrais."},{"disciplina":"EIXO TEMÁTICO 4 – ADMINISTRAÇÃO FINANCEIRA E ORÇAMENTÁRIA, CONTABILIDADE PÚBLICA E COMPRAS NA ADMINISTRAÇÃO PÚBLICA","texto":"Créditos ordinários e adicionais."},{"disciplina":"EIXO TEMÁTICO 4 – ADMINISTRAÇÃO FINANCEIRA E ORÇAMENTÁRIA, CONTABILIDADE PÚBLICA E COMPRAS NA ADMINISTRAÇÃO PÚBLICA","texto":"Alterações orçamentárias."},{"disciplina":"EIXO TEMÁTICO 4 – ADMINISTRAÇÃO FINANCEIRA E ORÇAMENTÁRIA, CONTABILIDADE PÚBLICA E COMPRAS NA ADMINISTRAÇÃO PÚBLICA","texto":"Dívida flutuante e fundada."},{"disciplina":"EIXO TEMÁTICO 4 – ADMINISTRAÇÃO FINANCEIRA E ORÇAMENTÁRIA, CONTABILIDADE PÚBLICA E COMPRAS NA ADMINISTRAÇÃO PÚBLICA","texto":"Convênios."},{"disciplina":"EIXO TEMÁTICO 5 – COMUNICAÇÃO, GESTÃO DOCUMENTAL, TRANSPARÊNCIA E PROTEÇÃO DE DADOS","texto":"Políticas de acesso aos documentos de arquivo."},{"disciplina":"Noções de Informática","texto":"Conceitos e modos de utilização de aplicativos para edição de textos, planilhas e apresentações."},{"disciplina":"Noções de Informática","texto":"Edição de textos, planilhas e apresentações em ambiente Windows."},{"disciplina":"Legislação Relativa à AGU","texto":"Lei nº 10.480, de 2 de julho de 2002, arts. 9º e 10, e alterações: noções básicas das atribuições do Órgão Vinculado, Procuradoria-Geral Federal."},{"disciplina":"Direito Constitucional","texto":"Normas constitucionais."},{"disciplina":"Noções de Direito Processual Civil","texto":"Processo e procedimento."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Orçamento público no Brasil."},{"disciplina":"Noções de Gestão de Pessoas nas Organizações","texto":"Competência interpessoal."},{"disciplina":"Noções de Gestão de Pessoas nas Organizações","texto":"Gestão por competências."},{"disciplina":"Noções de Direito Constitucional","texto":"Normas constitucionais."},{"disciplina":"Noções de Arquivologia","texto":"Protocolos."},{"disciplina":"Noções de Arquivologia","texto":"Arquivos permanentes."},{"disciplina":"Noções de Administração Pública","texto":"Empreendedorismo governamental e novas lideranças no setor público."},{"disciplina":"Noções de Administração Pública","texto":"O paradigma do cliente na gestão pública."},{"disciplina":"Administração Financeira e Orçamentária","texto":"Créditos adicionais."},{"disciplina":"Direito Administrativo","texto":"Controle do ato administrativo."},{"disciplina":"Direito Civil","texto":"Atos unilaterais."},{"disciplina":"Direito Civil","texto":"Registros públicos."},{"disciplina":"Direito Constitucional","texto":"Estado-membro: poder constituinte estadual, autonomia e limitações."},{"disciplina":"Direito Constitucional","texto":"Direitos e interesses das populações indígenas."},{"disciplina":"Direito do Trabalho e Processual do Trabalho","texto":"Desconsideração da personalidade jurídica."},{"disciplina":"Direito do Trabalho e Processual do Trabalho","texto":"Segurança e higiene do trabalho."},{"disciplina":"Direito Processual Penal","texto":"Habeas corpus."},{"disciplina":"Direito Processual Penal","texto":"Processo e julgamento dos crimes de responsabilidade dos funcionários públicos."},{"disciplina":"Direito Tributário","texto":"O Estado e o poder de tributar."},{"disciplina":"Direito Tributário","texto":"Direito tributário: conceito e princípios."},{"disciplina":"Direito Tributário","texto":"Repetição do indébito."},{"disciplina":"Direito Tributário","texto":"Impostos da União."},{"disciplina":"Direito Tributário","texto":"Impostos dos Estados e do Distrito Federal."},{"disciplina":"Direito Tributário","texto":"Impostos dos Municípios."},{"disciplina":"Conhecimentos Específicos","texto":"Organização e gestão de documentos; tipos de correspondências oficiais e suas especificações."},{"disciplina":"Conhecimentos Específicos","texto":"Conhecimentos sobre gestão de materiais, controle de patrimônio e inventários, gestão de Recursos Humanos e de administração financeira."},{"disciplina":"Conhecimentos Específicos","texto":"Aplicação de princípios da ortografia e de elementos da gramática à redação oficial."},{"disciplina":"Conhecimentos Específicos","texto":"Arquivologia: Gestão, classificação e avaliação de documentos; Organização, planejamento, sistemas e métodos de arquivamento; Arquivística e informática; Legislação arquivística."},{"disciplina":"Conhecimentos Específicos","texto":"Noções de administração pública: modelos de administração pública; princípios fundamentais da administração pública; órgãos, entidades e organização da administração pública; administração pública direta e indireta; descentralização, desconcentração e delegação; controle interno e externo aplicados à administração pública."},{"disciplina":"Conhecimentos Específicos","texto":"Lei nº 14.133, de 1º de abril de 2021 – Lei de Licitações."},{"disciplina":"Conhecimentos Específicos","texto":"Lei nº 12.527, de 18/11/2011, que regula o acesso a informações. Lei nº 13.709, de 14/08/2018, Lei Geral de Proteção de Dados."},{"disciplina":"Conhecimentos Específicos","texto":"Sistemas Operacionais e Configuração. Instalação e configuração de sistemas operacionais Windows, Linux e outros utilizados em ambiente corporativo. Configuração de parâmetros de rede para integração em redes locais (endereçamento IP, máscara, gateway e DNS). Gerenciamento de contas e permissões: criação, modificação e exclusão de usuários; atribuição de privilégios e grupos."},{"disciplina":"Conhecimentos Específicos","texto":"Compartilhamento de recursos: configuração de pastas e impressoras em rede, definição de permissões de acesso. Ferramentas administrativas: gerenciador de tarefas, serviços, logs do sistema e monitoramento de desempenho. Atualizações de sistema: instalação de patches de segurança e pacotes de melhorias."},{"disciplina":"Conhecimentos Específicos","texto":"Suporte a Aplicativos e Softwares Corporativos. Instalação, configuração e atualização de softwares de escritório (pacotes como LibreOffice e Microsoft Office). Suporte a navegadores e ferramentas de produtividade baseadas na web. Instalação e configuração de softwares corporativos específicos (ERP, CRM, ferramentas de gestão de projetos)."},{"disciplina":"Conhecimentos Específicos","texto":"Configuração e solução de problemas em clientes de e-mail (POP, IMAP e SMTP). Operação e suporte a sistemas de impressão e digitalização. Procedimentos de backup e restauração de dados, tanto local quanto em nuvem."},{"disciplina":"Conhecimentos Específicos","texto":"Atendimento ao Usuário e Boas Práticas de Suporte Metodologias de atendimento: service desk e help desk. Registro de chamados e utilização de sistemas de gestão de tickets. Coleta estruturada de informações para diagnóstico de problemas. Atendimento remoto: uso de softwares de acesso remoto e segurança na conexão."},{"disciplina":"Conhecimentos Específicos","texto":"Diagnóstico e Resolução de Problemas de Software. Solução de problemas de conectividade e configuração em redes locais e sem fio. Identificação e remoção de softwares maliciosos (malware, spyware, adware). Restauração de configurações de fábrica e reinstalação de sistemas operacionais quando necessário. Gerenciamento de inicialização e otimização de desempenho do sistema."},{"disciplina":"Conhecimentos Específicos","texto":"Segurança da Informação para Usuários. Princípios básicos de segurança da informação: confidencialidade, integridade e disponibilidade. Aplicação de políticas de senhas seguras e autenticação de múltiplos fatores. Uso seguro de e-mail e prevenção contra phishing. Noções de criptografia para proteção de dados sensíveis."},{"disciplina":"Conhecimentos Específicos","texto":"Utilização correta de ferramentas de proteção: antivírus, firewall pessoal e antimalware. Legislação e normas aplicáveis (Lei Geral de Proteção de Dados – LGPD, normas ISO/IEC relacionadas à segurança da informação)."},{"disciplina":"Conhecimentos Específicos","texto":"Fundamentos de Eletricidade e Segurança Eletroeletrônica. Conceitos básicos: tensão, corrente, potência e frequência. Corrente contínua (CC) e alternada (CA), tensão de pico e média. Riscos elétricos e métodos de prevenção. Aterramento elétrico e eletrostático na proteção de equipamentos. EPIs e cuidados de segurança na manutenção."},{"disciplina":"Conhecimentos Específicos","texto":"Equipamentos de Medição e Ferramentas. Uso de multímetros para medição de tensão, corrente e resistência. Teste de componentes: resistores, capacitores, transistores, diodos. Ferramentas básicas: chaves, pinças, extratores, pulseiras antiestáticas."},{"disciplina":"Conhecimentos Específicos","texto":"Arquitetura e Componentes. Placas-mãe: formatos, chipsets e soquetes. Processadores: arquiteturas 32 e 64 bits, núcleos e cache. Memórias: RAM (DDR e gerações), ROM e cache. Fontes de alimentação e gabinetes. Placas de expansão e periféricos básicos."},{"disciplina":"Conhecimentos Específicos","texto":"Armazenamento de Dados. HDs (IDE, SATA, SCSI, SAS) e SSDs. Configurações RAID: conceitos e aplicações. Unidades ópticas (CD, DVD, Blu-ray) e dispositivos removíveis."},{"disciplina":"Conhecimentos Específicos","texto":"Montagem e Manutenção Preventiva. Sequência correta de instalação de componentes. Conectorização de cabos e periféricos. Aplicação de pasta térmica e instalação de refrigeração. Limpeza física interna e verificação de conexões."},{"disciplina":"Conhecimentos Específicos","texto":"Diagnóstico e Manutenção Corretiva. Identificação de falhas de hardware. Testes físicos e funcionais com softwares e instrumentos. Substituição e atualização de componentes. Atualização de BIOS/UEFI."},{"disciplina":"Conhecimentos Específicos","texto":"Homologação e Documentação. Planos de testes e registro de resultados. Checklist de qualidade antes da entrega."},{"disciplina":"Conhecimentos Específicos","texto":"Segurança, Sustentabilidade e Organização. Organização e ergonomia no trabalho. Descarte correto de resíduos eletrônicos. Reaproveitamento de componentes quando possível."},{"disciplina":"Conhecimentos Específicos","texto":"Fundamentos de Redes: Conceitos, arquiteturas e topologias (LAN, MAN, WAN, WPAN, WLAN, WMAN, WWAN). Modelo OSI e TCP/IP: camadas, funções e protocolos. Endereçamento IPv4 e IPv6, máscaras e subredes. Protocolos TCP/IP, redes e sub-redes lógicas. Planejamento de redes: levantamento de necessidades, projeto da topologia, análise de cenários e custos/benefícios."},{"disciplina":"Conhecimentos Específicos","texto":"Cabeamento e Infraestrutura. Tipos de cabos, conectores e crimpagem. Normas técnicas e manuais de fabricantes. Cabeamento estruturado e telefonia IP (normas, tipos de cabos, terminação). Tecnologias FTTx e aplicações."},{"disciplina":"Conhecimentos Específicos","texto":"Instalação e Configuração de Redes. Procedimentos de configuração em sistemas operacionais. Terminal de comandos: manipulação de arquivos, diretórios, permissões, usuários, senhas, data/hora, testes de conectividade, compactação/descompactação. Configuração de dispositivos de rede: switches, roteadores, access points."},{"disciplina":"Conhecimentos Específicos","texto":"Redes sem Fio. Dispositivos e tecnologias. Normatização de frequências. Topologias e protocolos de redes sem fio. Equipamentos: antenas, bridge, access point, montagem e conectorização. Medição e qualidade do sinal (SNR)."},{"disciplina":"Conhecimentos Específicos","texto":"Segurança de Redes. Conceitos e tipos de ameaças. Softwares maliciosos, técnicas de ataque e proteção. Políticas de segurança, firewall, antivírus, antimalware. Segurança de roteadores e switches. Segurança e autenticação em redes sem fio. Certificados digitais: solicitação, instalação, configuração e revogação."},{"disciplina":"Conhecimentos Específicos","texto":"Monitoramento e Diagnóstico. Ferramentas: sniffers, exploits, port scanner, honeypot. Monitoramento de tráfego: desempenho, integridade e disponibilidade. Diagnóstico de falhas e substituição de componentes de rede. Testes e homologação."},{"disciplina":"Conhecimentos Específicos","texto":"Manipulação e conversão de áudio e vídeo digitais."},{"disciplina":"Conhecimentos Específicos","texto":"Fundamentos de Imagem e Televisão. Princípios da formação da imagem eletrônica e digital. Temperatura de cor e balanço de branco em sistemas de vídeo. Composição e enquadramento para transmissão televisiva dinâmica."},{"disciplina":"Conhecimentos Específicos","texto":"Equipamentos de Captação. Tipos de câmeras para TV e vídeo profissional: broadcast, ENG (Electronic News Gathering) e EFP (Electronic Field Production). Sistemas ópticos: tipos de lentes, distância focal e abertura. Controles operacionais: foco manual, íris, ganho, velocidade do obturador eletrônico (shutter speed) e filtros (ND filters)."},{"disciplina":"Conhecimentos Específicos","texto":"Técnicas de Operação. Movimentos de câmera: pan, tilt, dolly, truck, zoom, follow e crane. Operação com tripé de cabeça fluida, steadycam, gimbal e sistemas motorizados. Ajuste de exposição e compensação de iluminação em ambientes internos e externos. Procedimentos para captação em eventos ao vivo e externas jornalísticas."},{"disciplina":"Conhecimentos Específicos","texto":"Iluminação para TV. Fontes de luz contínua: LED, tungstênio e fluorescente de alta frequência. Técnicas de iluminação de três pontos (key, fill e back light). Uso de difusores, rebatedores e gelatinas corretivas."},{"disciplina":"Conhecimentos Específicos","texto":"Operação em Estúdio e Externa. Configuração e shading de câmeras para padronização de imagem. Comunicação e coordenação com equipe via intercom e talkback. Procedimentos de segurança e mobilidade em coberturas externas."},{"disciplina":"Conhecimentos Específicos","texto":"Manutenção Preventiva e Cuidados Operacionais. Limpeza e conservação de lentes e sensores. Armazenamento adequado de equipamentos e cabos. Verificação de firmware e testes de funcionamento antes das gravações."},{"disciplina":"Conhecimentos Específicos","texto":"Fundamentos da Edição de Vídeo. Conceitos de narrativa audiovisual: continuidade, ritmo, fluidez e coerência visual. Tipos de corte: corte seco, corte em ação, corte em L e J, jump cut, match cut. Uso de transições, sobreposições e efeitos de vídeo. Estruturação da timeline para diferentes gêneros televisivos (jornalismo, entretenimento, documentário)."},{"disciplina":"Conhecimentos Específicos","texto":"Softwares e Ferramentas de Edição. Plataformas não lineares (Non-Linear Editing – NLE): Adobe Premiere, Final Cut Pro, DaVinci Resolve, Avid Media Composer. Configuração de projetos: formatos, codecs, taxas de quadros e resolução. Ferramentas de corte, montagem, inserção de trilhas e manipulação de clipes. Sincronização de áudio e vídeo e uso de marcadores de tempo (timecode)."},{"disciplina":"Conhecimentos Específicos","texto":"Tratamento e Correção de Imagem. Conceitos básicos de cor: balanço de branco, saturação, contraste e gama. Correção primária e secundária de cores. Aplicação de LUTs e ajustes para padronização visual. Equalização de luminância para diferentes dispositivos de exibição."},{"disciplina":"Conhecimentos Específicos","texto":"Tratamento e Edição de Áudio. Ajuste de níveis e mixagem de faixas de áudio. Sincronização labial e alinhamento com imagem. Redução de ruídos, aplicação de filtros e efeitos sonoros. Integração de trilhas musicais e narrações com clareza e equilíbrio."},{"disciplina":"Conhecimentos Específicos","texto":"Composição Gráfica e Elementos Visuais. Inserção e animação de lower thirds, tarjas, vinhetas e logotipos. Criação e integração de legendas e closed captions. Sobreposição de gráficos, mapas e animações informativas."},{"disciplina":"Conhecimentos Específicos","texto":"Fluxo de Trabalho e Organização. Organização de arquivos e bins para otimização do processo. Criação de proxies para edição em alta performance. Nomeação e padronização de clipes e sequências. Controle de versões e backups periódicos."},{"disciplina":"Conhecimentos Específicos","texto":"Finalização e Exportação. Renderização com configurações otimizadas para TV aberta, TV a cabo e plataformas digitais. Padronização de formatos e codecs para transmissão. Conferência de áudio, vídeo e metadados antes da entrega final. Preparação de material para arquivamento e reutilização futura."},{"disciplina":"Conhecimentos Específicos","texto":"Ética, Direitos e Normas Técnicas. Respeito a direitos autorais de imagens, músicas e conteúdo. Adequação às normas técnicas de emissoras e órgãos reguladores. Boas práticas na manipulação de material sensível."},{"disciplina":"Conhecimentos Específicos","texto":"Fotografia em Diferentes Gêneros: Retrato: Enquadramento, poses e expressões; Paisagem: Uso de filtros (ND, polarizador) e longa exposição; Eventos sociais e cobertura jornalística: Fotografia espontânea e direção de pessoas; Macrofotografia e close-up: Equipamentos e técnicas específicas."},{"disciplina":"Conhecimentos Específicos","texto":"Fundamentos da Produção Audiovisual. Estrutura de produção televisiva: pré-produção, produção e pósprodução. Elaboração de storyboards, roteiros técnicos e decupagem de cenas. Definição de objetivos estéticos e narrativos conforme linguagem televisiva."},{"disciplina":"Conhecimentos Específicos","texto":"Planejamento Técnico e Logístico. Seleção de locações considerando aspectos técnicos de iluminação, acústica e acesso. Dimensionamento e alocação de recursos humanos e materiais. Elaboração de cronogramas de gravação e call sheets."},{"disciplina":"Conhecimentos Específicos","texto":"Supervisão de Captação. Direção de fotografia aplicada à televisão: coerência visual, padronização e continuidade. Coordenação com operadores de câmera e iluminadores. Ajuste de enquadramentos e movimentos para atender à narrativa."},{"disciplina":"Conhecimentos Específicos","texto":"Integração com Outras Áreas. Interface com direção de TV, produção de conteúdo e edição. Coordenação com equipe de áudio, cenografia e caracterização. Sincronização de múltiplas câmeras em estúdio e externa."},{"disciplina":"Conhecimentos Específicos","texto":"Qualidade de Imagem e Padrões Técnicos. Resoluções e formatos compatíveis com sistemas de transmissão. Relações de aspecto (aspect ratios) e segurança de área (safe area e title safe). Padrões de cor: Rec.709, Rec.2020 e HDR em produções televisivas."},{"disciplina":"Conhecimentos Específicos","texto":"Gestão de Arquivos e Fluxo de Trabalho. Organização e indexação de material bruto (footage). Controle de metadados e marcações para edição não linear. Armazenamento, preservação e redundância de acervos digitais."},{"disciplina":"Raciocínio Lógico e Matemático","texto":"Diagramas lógicos, tabelas e gráficos."},{"disciplina":"Raciocínio Lógico e Matemático","texto":"Álgebra básica: equações, sistemas e problemas do primeiro grau."},{"disciplina":"Raciocínio Lógico e Matemático","texto":"Porcentagem e proporcionalidade direta e inversa."},{"disciplina":"Raciocínio Lógico e Matemático","texto":"Sequências, reconhecimento de padrões, progressões aritmética e geométrica."},{"disciplina":"Raciocínio Lógico e Matemático","texto":"Medidas de comprimento, área, volume."},{"disciplina":"Raciocínio Lógico e Matemático","texto":"Princípios de contagem e noção de probabilidade."},{"disciplina":"Legislação do Estado do Amazonas","texto":"Resolução Legislativa n. 469/2010 – Institui o Regimento Interno da Assembleia Legislativa do Estado do Amazonas. Conhecimentos Específicos."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"CONTROLE INTERNO E EXTERNO – I."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Fundamentos do Controle na Administração Pública. 1."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Conceitos Básicos: Definições de controle interno e externo."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Diferenças entre controle prévio, concomitante e posterior. 2."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Tipos de fiscalização: ordinária, especial e por amostragem. 2."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Processos de Controle no TCEAM: Tomada e prestação de contas (CF, Art. 71)."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Julgamento das contas anuais do Governador e da ALEAM."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Unidades de auditoria interna e compliance. 2."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Processos de Controle Interno: Monitoramento da execução orçamentária e financeira."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Avaliação de conformidade em licitações e contratos."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Sistemas de Informação: SIAFI, SIDOR, SIGA e sistemas próprios da ALEAM."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Portal da Transparência e obrigações de divulgação. 2."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Lei nº 14.133/2021."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Auditoria interna segundo o IIA (Institute of Internal Auditors)."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Programa de auditoria."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Comunicação dos resultados: relatórios de auditoria."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Monitoramento."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"Supervisão e Controle de Qualidade."},{"disciplina":"Controle Interno e Externo e Auditoria Governamental","texto":"IPPF – Normas Internacionais para a prática profissional de auditoria interna."},{"disciplina":"Administração Financeira, Orçamentária e Responsabilidade Fiscal","texto":"Orçamento na Constituição de 1988: Plano Plurianual (PPA), Lei de Diretrizes Orçamentárias (LDO), Lei Orçamentária Anual (LOA). 3.2."},{"disciplina":"Administração Financeira, Orçamentária e Responsabilidade Fiscal","texto":"Leis de Créditos Adicio