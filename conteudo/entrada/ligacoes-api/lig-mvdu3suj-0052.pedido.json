,{"disciplina":"Conhecimentos Específicos","texto":"Procedimentos cirúrgicos: material cirúrgico, vias de acesso (craniotomia pterional, suboccipital, frontal, transesfenoidal, transpetrosa), acesso ao terceiro ventrículo, ventrículos laterais, transoral, cranioplastia, descompressão e instrumentação espinhais, derivações liquóricas.","cargo":"Médico – Especialidade: Neurocirurgião Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Neurotrauma: atendimento inicial, ATLS, transferência, pressão intracraniana, fraturas cranianas, lesões intracranianas, PAF, TCE na infância, manejo inicial do TRM, síndromes das lesões medulares, fraturas dos corpos vertebrais.","cargo":"Médico – Especialidade: Neurocirurgião Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Doença cerebrovascular: AVC, HSAE (classificação, manejo, vasoespasmo), aneurismas intracranianos, MAVs, angiomas cavernosos, hemorragia intracerebral, doença oclusiva.","cargo":"Médico – Especialidade: Neurocirurgião Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Neurologia: cefaleia, demência, esclerose múltipla, miastenia gravis, esclerose lateral amiotrófica, síndrome de Guillain‐Barré, mielites, miopatias, vasculites.","cargo":"Médico – Especialidade: Neurocirurgião Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Doenças neurológicas com manifestações extrapiramidais.","cargo":"Médico – Especialidade: Neurologista"},{"disciplina":"Conhecimentos Específicos","texto":"Diagnóstico de traumatismo crânio‐ encefálico.","cargo":"Médico – Especialidade: Neurologista"},{"disciplina":"Conhecimentos Específicos","texto":"Fundamentos Básicos de Medicina: Valor da história clínica e interpretação do exame físico.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Princípios da Assistência ao paciente: medicina baseada em evidências, medicina baseada na pessoa, relação médico‐ paciente, ética médica, bioética e tomada de decisões.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Conhecimentos na área de formação: Bases genéticas e biologia molecular do câncer.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Etiologia e epidemiologia do câncer infantil.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Tumores prevalentes na infância.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Aspectos gerais do câncer na infância.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Princípios do tratamento do câncer; anticorpos monoclonais; quimioterapia; radioterapia; terapia alvo molecular; imunoterapia.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Desenho e análise de estudos clínicos em oncologia.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Retinoblastoma.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Neuroblastoma.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Sarcoma de Ewing.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Rabdomiossarcoma.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Tumor de Wilms.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Tumores ósseos.","cargo":"Médico – Especialidade: Oncologista Pediátrico"},{"disciplina":"Conhecimentos Específicos","texto":"Tumor de células germinativas.","cargo":"Médico – Especialidade: On