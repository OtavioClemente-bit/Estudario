<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Modo foco: ligar e desligar o Não Perturbe durante a sessão de estudo. A pessoa ainda
         precisa conceder o acesso uma vez nas configurações do Android. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Integração com Calendário Nativo -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    
    <application
        android:name=".EstudarioApplication"
        android:largeHeap="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Estudario">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:theme="@style/Theme.Estudario.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Abrir com: arquivos .estudo, .plano e backups (JSON). Muitos apps informam
                 .estudo/.plano como octet-stream ou text/plain, por isso os tipos amplos. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/x-json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Compartilhar: o arquivo gerado pela IA ou o texto (JSON) da resposta. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/x-json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Botão "Encerrar" da notificação do modo foco: precisa funcionar com o app fechado. -->
        <receiver
            android:name=".focus.FocusActionReceiver"
            android:exported="false" />

        <!-- Botão "Lembrar em 1 hora" das notificações de estudo. -->
        <receiver
            android:name=".notifications.ReminderActionReceiver"
            android:exported="false" />

        <!-- Widget: Próxima Missão -->
        <receiver
            android:name=".ui.widget.EstudarioWidgetReceiver"
            android:label="Próxima missão"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/estudario_widget_info" />
        </receiver>
        <!-- Widget: Plano do dia -->
        <receiver
            android:name=".ui.widget.DayPlanWidgetReceiver"
            android:label="Plano do dia"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day_plan_info" />
        </receiver>
        <!-- Widget: Semana de estudos -->
        <receiver
            android:name=".ui.widget.WeekWidgetReceiver"
            android:label="Semana de estudos"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>
        <!-- Widget: Contagem para a prova -->
        <receiver
            android:name=".ui.widget.CountdownWidgetReceiver"
            android:label="Contagem para a prova"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown_info" />
        </receiver>
        <!-- Widget: Revisões de hoje -->
        <receiver
            android:name=".ui.widget.ReviewsWidgetReceiver"
            android:label="Revisões de hoje"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_reviews_info" />
        </receiver>
        <!-- Widget: Questão do dia -->
        <receiver
            android:name=".ui.widget.QuestionWidgetReceiver"
            android:label="Questão do dia"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_question_info" />
        </receiver>
        <!-- Widget: Foco -->
        <receiver
            android:name=".ui.widget.FocusWidgetReceiver"
            android:label="Foco"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_focus_info" />
        </receiver>
        <!-- Widget: Constância -->
        <receiver
            android:name=".ui.widget.StreakWidgetReceiver"
            android:label="Constância"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>
        <!-- AdMob: id do app (o de teste do Google quando o projeto não tem o id real). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
    </application>
</manifest>
