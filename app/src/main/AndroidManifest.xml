<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Modo foco: ligar e desligar o Não Perturbe durante a sessão de estudo. A pessoa ainda
         precisa conceder o acesso uma vez nas configurações do Android. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Só para a conta Google e o backup no Drive: todo o estudo continua funcionando sem rede. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:name=".EstudarioApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Estudario">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Estudario.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Abrir com: arquivos .estudo, .plano e backups (JSON). Muitos apps informam
                 .estudo/.plano como octet-stream ou text/plain, por isso os tipos amplos. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/x-json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Compartilhar: o arquivo gerado pela IA ou o texto (JSON) da resposta. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <data android:mimeType="text/x-json" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Botão "Encerrar" da notificação do modo foco: precisa funcionar com o app fechado. -->
        <receiver
            android:name=".focus.FocusActionReceiver"
            android:exported="false" />
    </application>
</manifest>
