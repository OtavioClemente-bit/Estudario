<?xml version="1.0" encoding="utf-8"?>
<!-- Nunito para os textos desenhados pelo Android (teoria, enunciados, fórmulas): normal e negrito reais. -->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font app:fontStyle="normal" app:fontWeight="400" app:font="@font/nunito_400" />
    <font app:fontStyle="normal" app:fontWeight="500" app:font="@font/nunito_500" />
    <font app:fontStyle="normal" app:fontWeight="600" app:font="@font/nunito_600" />
    <font app:fontStyle="normal" app:fontWeight="700" app:font="@font/nunito_700" />
    <font app:fontStyle="normal" app:fontWeight="800" app:font="@font/nunito_800" />
    <font app:fontStyle="normal" app:fontWeight="900" app:font="@font/nunito_900" />
</font-family>
