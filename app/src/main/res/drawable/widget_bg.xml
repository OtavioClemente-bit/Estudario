<?xml version="1.0" encoding="utf-8"?>
<!-- Recorte de adesivo do Estudário (como cutPanel no app): sombra sólida deslocada e contorno de caneta. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle"><solid android:color="#14113A" /><corners android:radius="26dp" /></shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><solid android:color="#FFFDF8" /><stroke android:width="2.5dp" android:color="#14113A" /><corners android:radius="26dp" /></shape>
    </item>
</layer-list>
