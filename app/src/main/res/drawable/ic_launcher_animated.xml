<?xml version="1.0" encoding="utf-8"?>
<!-- Splash de abertura: o livro do ícone folheia uma página, da direita para a esquerda, levando o
     desenho da página junto. O quadro final é idêntico ao ícone parado (o verso da página é
     exatamente a página esquerda), então não há salto quando a splash some.
     No Android 11 e anteriores a splash mostra só o primeiro quadro, que é o ícone normal. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <group android:pivotX="54" android:pivotY="59.5" android:scaleX="0.66" android:scaleY="0.66" android:translateY="-5.5">
        <path android:fillColor="#FFFFFF" android:pathData="M16,28 L51,34 L51,82 L16,76 Z" />
        <path android:fillColor="#FFFFFF" android:pathData="M57,34 L92,28 L92,76 L57,82 Z" />
        <path android:strokeColor="#3326CE" android:strokeWidth="3.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M22,43.53 L38,46.27" />
        <path android:strokeColor="#3326CE" android:strokeWidth="2.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M22,52.53 L45,56.47" />
        <path android:strokeColor="#3326CE" android:strokeWidth="2.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M22,60.03 L45,63.97" />
        <path android:strokeColor="#3326CE" android:strokeWidth="2.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M22,67.53 L36,69.93" />
        <path android:strokeColor="#3326CE" android:strokeWidth="3.8" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M67.5,53.5 L73,59 L84.5,45" />
        <path android:strokeColor="#3326CE" android:strokeWidth="2.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M66,72.96 L86,69.53" />
                <group android:name="front" android:pivotX="54" android:pivotY="34">
            <path android:name="front_page" android:fillColor="#FFFFFF" android:pathData="M57,34 L92,28 L92,76 L57,82 Z" />
            <path android:strokeColor="#3326CE" android:strokeWidth="3.8" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M67.5,53.5 L73,59 L84.5,45" />
            <path android:strokeColor="#3326CE" android:strokeWidth="2.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M66,72.96 L86,69.53" />
                </group>
                <group android:name="back" android:pivotX="54" android:pivotY="34" android:scaleX="0">
            <path android:name="back_page" android:fillColor="#C9C3FF" android:pathData="M16,28 L51,34 L51,82 L16,76 Z" />
            <path android:strokeColor="#3326CE" android:strokeWidth="3.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M22,43.53 L38,46.27" />
            <path android:strokeColor="#3326CE" android:strokeWidth="2.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M22,52.53 L45,56.47" />
            <path android:strokeColor="#3326CE" android:strokeWidth="2.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M22,60.03 L45,63.97" />
            <path android:strokeColor="#3326CE" android:strokeWidth="2.6" android:strokeLineCap="round" android:strokeLineJoin="round" android:pathData="M22,67.53 L36,69.93" />
                </group>
        <path android:fillColor="#7EE0B8" android:pathData="M60,32.89 L64.5,32.11 L64.5,91 L62.25,88 L60,91 Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="front">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="1" android:valueTo="0"
                    android:startOffset="220" android:duration="330"
                    android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="translateY" android:valueFrom="0" android:valueTo="-4"
                    android:startOffset="220" android:duration="330"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="back">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1"
                    android:startOffset="550" android:duration="330"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator android:propertyName="translateY" android:valueFrom="-4" android:valueTo="0"
                    android:startOffset="550" android:duration="330"
                    android:interpolator="@android:interpolator/accelerate_quad" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="front_page">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillColor" android:valueType="colorType"
                android:valueFrom="#FFFFFF" android:valueTo="#C9C3FF"
                android:startOffset="220" android:duration="330"
                android:interpolator="@android:interpolator/accelerate_quad" />
        </aapt:attr>
    </target>

    <target android:name="back_page">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillColor" android:valueType="colorType"
                android:valueFrom="#C9C3FF" android:valueTo="#FFFFFF"
                android:startOffset="550" android:duration="330"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>
</animated-vector>
