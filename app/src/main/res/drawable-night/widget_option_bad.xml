<?xml version="1.0" encoding="utf-8"?>
<!-- Recorte de adesivo do Estudário (como cutPanel no app): sombra sólida deslocada e contorno de caneta. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#05070F" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle"><solid android:color="#4A2230" /><stroke android:width="2dp" android:color="#FF8A80" /><corners android:radius="12dp" /></shape>
    </item>
</layer-list>
