# Local-only values emitted by `supabase start` or supplied by the local test harness.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-anon-key

# Server-only values are intentionally absent. Do not add OPENAI_API_KEY or a
# Supabase service-role key to this example or to the repository.
